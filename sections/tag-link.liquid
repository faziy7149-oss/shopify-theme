<script>
	$(function(){
      if($(window).width() < 767){
      	if($(".tags_a").length >= 6){
			$(".tags_a:gt(5)").hide();
        }else{
        	$(".tag_omit span").hide();
        }
      }
      $('.tag_omit span').click(function(){
      	$('.tags_a:gt(5)').toggle("fast","swing");
      })
	})
</script>

