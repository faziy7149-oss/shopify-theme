{% style %}
   .section-id-{{ section.id }} .container_grid .credit_cta {
     z-index: 9;
     position: relative;
   }
  .section-id-{{ section.id }} .container_grid {
     display: grid;
   }
  .section-id-{{ section.id }} .portrait_img > img,
  .section-id-{{ section.id }} .frame > img {
     width: 100%;
     height: 100%;
     object-fit: contain;
     display: block;
   }
  .section-id-{{ section.id }} .frame {
     display: grid;
     justify-items: center;
   }
  .section-id-{{ section.id }} .product_link .credit_list,
  .section-id-{{ section.id }} .credit_list_item {
     margin: 0;
     padding: 0;
     list-style: none;
   }
   @media (max-width: 767px) {
    .section-id-{{ section.id }} .container_grid {
       grid-template-rows: repeat(7, 20px 10em 20px);
       grid-template-columns: 8% 6% 10% 28% 1% 1% 5% 1% 18% 20% 2%;
     }
    .section-id-{{ section.id }} .portrait_img2,
    .section-id-{{ section.id }} .portrait_img4,
    .section-id-{{ section.id }} .frame_container1,
    .section-id-{{ section.id }} .frame_container3 {
       grid-column: 3/8;
     }
    .section-id-{{ section.id }} .portrait_img1,
    .section-id-{{ section.id }} .portrait_img3 {
       grid-column: 5/11;
     }
    .section-id-{{ section.id }} .frame_container2,
    .section-id-{{ section.id }} .frame_container4 {
       grid-column: 5/11;
     }
     /* 人像大小 */
    .section-id-{{ section.id }} .portrait_img1 {
       grid-row: 1/6;
     }
    .section-id-{{ section.id }} .portrait_img2 {
       grid-row: 5/12;
     }
    .section-id-{{ section.id }} .portrait_img3 {
       grid-row: 11/16;
     }
    .section-id-{{ section.id }} .portrait_img4 {
       grid-row: 15/21;
     }
     /* 选项卡背景大小 */
    .section-id-{{ section.id }} .frame_container1 {
       grid-row: 2/4;
     }
    .section-id-{{ section.id }} .frame_container2 {
       grid-row: 6/9;
     }
    .section-id-{{ section.id }} .frame_container3 {
       grid-row: 11/13;
       margin-top: 45px;
     }
    .section-id-{{ section.id }} .frame_container4 {
       grid-row: 17/19;
     }
    .section-id-{{ section.id }} .frame {
       grid-template-rows: 5em 8em 1em;
       grid-template-columns: 0.5fr 3fr 2fr;
     }
    .section-id-{{ section.id }} .frame img {
       grid-column: 1/4;
       grid-row: 1/4;
     }

    .section-id-{{ section.id }} .product_link {
       grid-row: 2/3;
       grid-column: 2/4;
       gap: 10px;
     }
    .section-id-{{ section.id }} .product_link .credit_list .credit_list_item a {
       font-size: 10px;
     }
   }
   @media (min-width: 768px) {
   .section-id-{{ section.id }}  .container_grid {
       grid-template-rows: repeat(29, 100px);
       grid-template-columns: 19% 5% 5% 14% 12% 1% 1% 1% 14% 12% 16%;
     }
   .section-id-{{ section.id }}  .portrait_img2,
   .section-id-{{ section.id }}  .portrait_img4,
   .section-id-{{ section.id }}  .frame_container1,
   .section-id-{{ section.id }}  .frame_container3 {
       grid-column: 4/6;
     }
   .section-id-{{ section.id }}  .portrait_img1,
   .section-id-{{ section.id }}  .portrait_img3 {
       grid-column: 5/11;
     }
   .section-id-{{ section.id }}  .frame_container2,
   .section-id-{{ section.id }}  .frame_container4 {
       grid-column: 9/11;
     }
     /* 人像大小 */
    .section-id-{{ section.id }} .portrait_img1 {
       grid-row: 1/8;
     }
    .section-id-{{ section.id }} .portrait_img2 {
       grid-row: 7/14;
     }
    .section-id-{{ section.id }} .portrait_img3 {
       grid-row: 14/21;
     }
    .section-id-{{ section.id }} .portrait_img4 {
       grid-row: 21/28;
     }
     /* 选项卡背景大小 */
    .section-id-{{ section.id }} .frame_container1 {
       grid-row: 2/4;
     }
    .section-id-{{ section.id }} .frame_container2 {
       grid-row: 8/9;
     }
    .section-id-{{ section.id }} .frame_container3 {
       grid-row: 15/16;
     }
    .section-id-{{ section.id }} .frame_container4 {
       grid-row: 22/23;
     }
    .section-id-{{ section.id }} .frame {
       grid-template-rows: 130px 200px 100px;
       grid-template-columns: 0.5fr 3fr 1fr;
     }
    .section-id-{{ section.id }} .frame img {
       height: 90%;
       grid-column: 1/4;
       grid-row: 1/4;
     }

    .section-id-{{ section.id }} .product_link {
       grid-row: 2/3;
       grid-column: 2/3;
       gap: 10px;
     }
    .section-id-{{ section.id }} .credit_list_item {
       margin: 15px 0;
     }
   }
{% endstyle %}

<div class="section-id-{{ section.id }}">
  <div class="wrapper">
    <div class="container">
      <div class="section__container">
        <div class="container_grid">
          {%- for block in section.blocks -%}
            {% case block.type %}
              {% when 'Portrait' %}
                <div style="display:none;">{% increment portrait_num %}</div>
                <div class="portrait_img{{ portrait_num }} portrait_img">
                  {% render 'image' with block.settings.portrait_image, sizes: '1980px', loading: 'lazy' %}
                </div>
              {% when 'Card' %}
                <div style="display:none;">{% increment variable %}</div>
                <div class="frame_container{{ variable }}">
                  <div class="frame">
                    {% render 'image' with block.settings.image, sizes: '1980px', loading: 'lazy' %}
                    <div class="product_link">
                      <ul class="credit_list">
                        {% if block.settings.card_product_text1 %}
                          <li class="credit_list_item">
                            <a href="{{ block.settings.product_link1 }}" class="credit_cta">
                              {{- block.settings.card_product_text1 -}}
                            </a>
                          </li>
                        {% endif %}
                        {% if block.settings.card_product_text2 %}
                          <li class="credit_list_item">
                            <a href="{{ block.settings.product_link2 }}" class="credit_cta">
                              {{- block.settings.card_product_text2 -}}
                            </a>
                          </li>
                        {% endif %}
                        {% if block.settings.card_product_text3 %}
                          <li class="credit_list_item">
                            <a href="{{ block.settings.product_link3 }}" class="credit_cta">
                              {{- block.settings.card_product_text3 -}}
                            </a>
                          </li>
                        {% endif %}
                        {% if block.settings.card_product_text4 %}
                          <li class="credit_list_item">
                            <a href="{{ block.settings.product_link4 }}" class="credit_cta">
                              {{- block.settings.card_product_text4 -}}
                            </a>
                          </li>
                        {% endif %}
                      </ul>
                    </div>
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Card Link",
  "settings": [

  ],
  "blocks": [
    {
     "type": "Card",
     "name": "Card",
     "limit":4,
     "settings": [
      {
         "type": "image_picker",
         "id": "image",
         "label": "Image"
      },
      {
         "type": "text",
         "id": "card_product_text1",
         "label": "text"
       },
       {
    "type":"url",
    "id":"product_link1",
    "label":"product link"
     },
        {
         "type": "text",
         "id": "card_product_text2",
         "label": "text"
       },
       {
    "type":"url",
    "id":"product_link2",
    "label":"product link"
     },
        {
         "type": "text",
         "id": "card_product_text3",
         "label": "text"
       },
       {
    "type":"url",
    "id":"product_link3",
    "label":"product link"
     },
        {
         "type": "text",
         "id": "card_product_text4",
         "label": "text"
       },
       {
    "type":"url",
    "id":"product_link4",
    "label":"product link"
     }
     ]
   },
   {
   "type": "Portrait",
   "name": "Portrait",
   "limit":4,
   "settings": [
    {
       "type": "image_picker",
       "id": "portrait_image",
       "label": "Image"
    }
     ]
   }
  ],
   "presets": [
    {
      "name": "Card Link",
      "blocks": [
        {
          "type": "Card"
        },
        {
          "type": "Portrait"
        }
      ]
    }
  ]

}
{% endschema %}
