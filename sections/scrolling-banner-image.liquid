<script>
  (function () {
    var sectionRoot = document.getElementById('section-id-{{ section.id }}');
    if (!sectionRoot || typeof Swiper === 'undefined') return;

    var swiperEl = sectionRoot.querySelector('.scrolling-banner-image-swiper');
    if (!swiperEl) return;

    var swiperInstance = null;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function destroySwiper() {
      if (swiperInstance) {
        swiperInstance.destroy(true, true);
        swiperInstance = null;
      }
    }

    function clearSelection() {
      if (window.getSelection) {
        var selection = window.getSelection();
        if (selection && selection.removeAllRanges) selection.removeAllRanges();
      }
    }

    function initSwiper() {
      if (!swiperEl) return;

      var slideCount = parseInt(swiperEl.getAttribute('data-slide-count'), 10) || 0;
      var enableLoop = slideCount > 1;
      var enableAutoplay = swiperEl.getAttribute('data-autoplay') === 'true' && !reduceMotion && enableLoop;

      destroySwiper();

      swiperInstance = new Swiper(swiperEl, {
        effect: reduceMotion ? 'slide' : 'cards',
        grabCursor: true,
        loop: enableLoop,
        observer: true,
        observeParents: true,
        navigation: {
          nextEl: sectionRoot.querySelector('.swiper-button-next'),
          prevEl: sectionRoot.querySelector('.swiper-button-prev')
        },
        autoplay: enableAutoplay
          ? {
              delay: 4000,
              pauseOnMouseEnter: true,
              disableOnInteraction: false
            }
          : false,
        cardsEffect: {
          perSlideOffset: 8,
          perSlideRotate: 2,
          rotate: true,
          slideShadows: false
        },
        on: {
          init: function () {
            this.update();
          },
          slideChangeTransitionStart: clearSelection,
          navigationNext: clearSelection,
          navigationPrev: clearSelection
        }
      });

      sectionRoot.querySelectorAll('.swiper-button-next, .swiper-button-prev').forEach(function (btn) {
        btn.addEventListener('mousedown', function (event) {
          event.preventDefault();
          clearSelection();
        });
      });
    }

    initSwiper();

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.contains(sectionRoot)) {
        sectionRoot = document.getElementById('section-id-{{ section.id }}') || sectionRoot;
        swiperEl = sectionRoot.querySelector('.scrolling-banner-image-swiper');
        initSwiper();
      }
    });

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target && event.target.contains(sectionRoot)) {
        destroySwiper();
      }
    });
  })();
</script>
