{% style %}
  #section-id-{{ section.id }} {
    --vertical-padding: {{ section.settings.vertical_padding }}px;
    --card-width: {{ section.settings.card_width }}%;
    --card-max-width: {{ section.settings.card_max_width }}px;
  }

  .section-id-{{ section.id }} {
    position: relative;
    margin: 3rem 0;
    max-width: 100%;
  }

  /*
    只用 clip 裁切横向溢出：overflow-x: hidden 会把 overflow-y 算成 auto，
    从而在模块上出现多余的竖向滚动条。
  */
  #shopify-section-{{ section.id }} {
    max-width: 100%;
    overflow-x: clip;
    overflow-y: clip;
  }

  .section-id-{{ section.id }} .scrolling-banner-image__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
  }

  .section-id-{{ section.id }} .marquee-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    z-index: 1;
  }

  .section-id-{{ section.id }} .carousel-image-wrap {
    position: relative;
    z-index: 9;
    display: block;
    width: var(--card-width);
    max-width: var(--card-max-width);
    margin: 0 auto;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .section-id-{{ section.id }} .carousel-image-wrap .swiper {
    overflow: visible;
  }

  /* Swiper cards 切换时会注入黑色阴影层，需彻底关掉 */
  .section-id-{{ section.id }} .carousel-image-wrap .swiper-slide-shadow,
  .section-id-{{ section.id }} .carousel-image-wrap .swiper-slide-shadow-left,
  .section-id-{{ section.id }} .carousel-image-wrap .swiper-slide-shadow-right,
  .section-id-{{ section.id }} .carousel-image-wrap .swiper-slide-shadow-top,
  .section-id-{{ section.id }} .carousel-image-wrap .swiper-slide-shadow-bottom,
  .section-id-{{ section.id }} .carousel-image-wrap .swiper-3d .swiper-slide-shadow {
    display: none !important;
    opacity: 0 !important;
    background: transparent !important;
    pointer-events: none !important;
  }

  .section-id-{{ section.id }} .carousel-image-link {
    display: block;
    -webkit-user-select: none;
    user-select: none;
  }

  .section-id-{{ section.id }} .carousel-image-link:focus,
  .section-id-{{ section.id }} .carousel-image-link:active {
    outline: none;
  }

  .section-id-{{ section.id }} .carousel-image-block,
  .section-id-{{ section.id }} .carousel-image-block img,
  .section-id-{{ section.id }} .swiper-slide img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
    user-drag: none;
    pointer-events: none;
  }

  .section-id-{{ section.id }} .swiper-slide,
  .section-id-{{ section.id }} .swiper-slide * {
    -webkit-user-select: none;
    user-select: none;
  }

  .section-id-{{ section.id }} .swiper-slide ::selection,
  .section-id-{{ section.id }} .carousel-image-wrap ::selection {
    background: transparent;
    color: inherit;
  }

  .section-id-{{ section.id }} .swiper-button-next,
  .section-id-{{ section.id }} .swiper-button-prev {
    color: inherit;
    -webkit-user-select: none;
    user-select: none;
  }

  .section-id-{{ section.id }} .swiper-button-next:after,
  .section-id-{{ section.id }} .swiper-button-prev:after {
    font-size: 28px;
  }

  @media (max-width: 767px) {
    .section-id-{{ section.id }} .carousel-image-wrap {
      width: min(72%, calc(var(--card-max-width) * 0.75));
      max-width: 280px;
    }

    /* 移动端卡片旋转偏移更大，额外限制触摸横向冒泡 */
    .section-id-{{ section.id }} .carousel-image-wrap .swiper {
      touch-action: pan-y;
    }

    .section-id-{{ section.id }} .swiper-button-prev,
    .section-id-{{ section.id }} .swiper-button-next {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-id-{{ section.id }} .marquee--animate .marquee-content {
      animation: none;
    }
  }
{% endstyle %}

<script src="{{ 'scrolling-banner.js' | asset_url }}" defer></script>

{%- liquid
  assign carousel_slide_count = 0
  for block in section.blocks
    if block.type == 'carouselImage' and block.settings.scrolling_banner_image_pc != blank
      assign carousel_slide_count = carousel_slide_count | plus: 1
    endif
  endfor
-%}

<scrolling-banner id="section-id-{{ section.id }}" class="block section-id-{{ section.id }}" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
  {%- unless section.settings.full_width -%}<div class="container container--not-mobile">{%- endunless -%}

  <div class="scrolling-banner-image__stage">
    <div class="marquee-container {% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }}{% endif %}">
      <div class="marquee marquee--{{ section.settings.direction }}
          {% if section.settings.font == 'heading' %} heading-font{% endif %}"
          style="--duration: {{ 42 | minus: section.settings.speed }}s; --space: {{ section.settings.space }}px; --text-size: {{ section.settings.text_size }}px" role="marquee">
        {%- capture scrolling_content -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'text' %}
              {%- liquid
                assign text = block.settings.text
                if block.settings.stencil_all_text == false and block.settings.stencil_text != blank
                  assign words = block.settings.stencil_text | split: ","
                  for word in words
                    assign trimmed_word = word | strip
                    assign replacement_text = "{" | append: trimmed_word | append: "}"
                    assign text = text | replace: trimmed_word, replacement_text
                  endfor

                  assign text = text | replace: "{", "<span class='marquee-stencil-this'>"
                  assign text = text | replace: "}", "</span>"
                endif

                if block.settings.link
                  assign contains_link = true
                endif
              -%}

              <span class="marquee-item marquee-text{% if block.settings.stencil_all_text %} marquee-text--stencil{% endif %}" style="{% unless block.settings.color contains ',0)' %}--color: {{ block.settings.color }}{% endunless %}" {{ block.shopify_attributes }}>
                {%- if block.settings.use_h1 -%}
                  <h1 class="marquee-item_h1">
                {%- endif -%}
                {%- if block.settings.link -%}
                  <a href="{{ block.settings.link }}">
                {%- endif -%}
                {{- text -}}
                {%- if block.settings.link -%}
                  </a>
                {%- endif -%}
                {%- if block.settings.use_h1 -%}
                  </h1>
                {%- endif -%}
              </span>

            {%- elsif block.type == 'icon' %}
              <span class="marquee-item marquee-icon" style="--width: {{ block.settings.icon_width }}px; {% unless block.settings.color contains ',0)' %}--color: {{ block.settings.color }}{% endunless %}" {{ block.shopify_attributes }}>
                {%- render 'icon', icon: block.settings.icon -%}
              </span>

            {%- elsif block.type == 'image' %}
              <span class="marquee-item marquee-image" style="--width: {{ block.settings.image_width }}px" {{ block.shopify_attributes }}>
                {%- if block.settings.link -%}
                  {%- assign contains_link = true -%}
                  <a href="{{ block.settings.link }}">
                {%- endif -%}

                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign image_sizes = block.settings.image_width | append: 'px'
                    assign image_widths = block.settings.image_width | times: 2 | prepend: ', ' | prepend: block.settings.image_width
                  -%}
                  {%- render 'image' with block.settings.image, sizes: image_sizes, widths: image_widths -%}
                {%- else -%}
                  <span class="placeholder-image">
                    {{- 'logo' | placeholder_svg_tag: 'placeholder-svg' -}}
                  </span>
                {%- endif -%}

                {%- if block.settings.link -%}
                  </a>
                {%- endif -%}
              </span>

            {%- elsif block.type == 'button' %}
              {%- liquid
                if block.settings.link
                  assign contains_link = true
                endif
              -%}
              <span class="marquee-item marquee-button" style="{% if block.settings.button_style == 'custom' %}--btn-col-bg: {{ block.settings.color_bg }}; --btn-col-text: {{ block.settings.color_text }}{% endif %}" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}" class="btn btn--{{ block.settings.button_style }} btn--link"><span class="btn__text">{{ block.settings.text }}</span></a>
              </span>

            {%- elsif block.type == 'countdown' -%}
              <div class="marquee-item marquee-countdown align-center block-id-{{ block.id }} countdown-font-{{ section.settings.font }} countdown-divider-{{ block.settings.divider_type }}" {{ block.shopify_attributes }}>
                <style>
                  .block-id-{{ block.id }} .countdown {
                    --countdown-desktop-size: {{ block.settings.number_size }}px;
                    {% unless block.settings.color contains ',0)' %}
                      --heading-color: {{ block.settings.color.rgb }};
                      --link-color: {{ block.settings.color.rgb }};
                      color: {{ block.settings.color }};
                    {% endunless %}
                  }
                </style>
                <script src="{{ 'countdown-timer.js' | asset_url }}" defer></script>
                {% render 'countdown-timer',
                  end_date: block.settings.end_date,
                  end_time: block.settings.end_time,
                  end_text: block.settings.end_text,
                  end_midnight: true,
                  hide_on_end: block.settings.hide_on_end,
                  show_labels: block.settings.show_timer_labels
                %}
              </div>

            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- for i in (1..15) -%}
          <span class="marquee-content{% if contains_link %} marquee-content--contains-link{% endif %}"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
            {%- if forloop.first -%}
              {{ scrolling_content }}
            {%- else -%}
              {{ scrolling_content | replace: '<a ', '<a tabindex="-1" ' | replace: '<h1 class="marquee-item_h1">' , '<span>' | replace: '</h1>', '</span>' }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    </div>

    {%- if carousel_slide_count > 0 -%}
      <div class="carousel-image-wrap">
        <div class="swiper scrolling-banner-image-swiper" data-slide-count="{{ carousel_slide_count }}" data-autoplay="{{ section.settings.autoplay }}">
          <div class="swiper-wrapper">
            {%- assign carousel_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'carouselImage' and block.settings.scrolling_banner_image_pc != blank -%}
                {%- liquid
                  assign carousel_index = carousel_index | plus: 1
                  if carousel_index == 1
                    assign carousel_loading = 'eager'
                  else
                    assign carousel_loading = 'lazy'
                  endif
                -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.scrolling_image_link != blank -%}
                    <a class="carousel-image-link" href="{{ block.settings.scrolling_image_link }}">
                  {%- endif -%}

                  {%- if block.settings.scrolling_banner_image_mobile != blank -%}
                    {%- render 'image-desktop-and-mobile',
                      desktop_image: block.settings.scrolling_banner_image_pc,
                      mobile_image: block.settings.scrolling_banner_image_mobile,
                      loading: carousel_loading,
                      class: 'carousel-image-block',
                      size_cols_desktop: 1,
                      block: block
                    -%}
                  {%- else -%}
                    {%- render 'image' with block.settings.scrolling_banner_image_pc,
                      sizes: '(min-width: 768px) min(36vw, 420px), 280px',
                      class: 'carousel-image-block',
                      loading: carousel_loading
                    -%}
                  {%- endif -%}

                  {%- if block.settings.scrolling_image_link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="swiper-button-prev" aria-label="{{ 'general.slider.previous' | t }}"></div>
          <div class="swiper-button-next" aria-label="{{ 'general.slider.next' | t }}"></div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- unless section.settings.full_width -%}</div>{%- endunless -%}
</scrolling-banner>

{% schema %}
{
  "name": "Scrolling banner image",
  "class": "section-scrolling-banner-image",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "id": "full_width",
      "type": "checkbox",
      "label": "Full page width",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Text size",
      "default": 50
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "speed",
      "min": 0.5,
      "max": 40,
      "step": 0.5,
      "unit": "x",
      "label": "Speed",
      "default": 35
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "label": "Left to right",
          "value": "right"
        },
        {
          "label": "Right to left",
          "value": "left"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "font",
      "label": "Font",
      "options": [
        {
          "label": "Text font",
          "value": "base"
        },
        {
          "label": "Heading font",
          "value": "heading"
        }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "space",
      "min": 0,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Space between items",
      "default": 50
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 20,
      "max": 70,
      "step": 1,
      "unit": "%",
      "label": "Card image width",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_max_width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Card image max width",
      "info": "Limits how large cards can grow on wide screens.",
      "default": 420
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate card images",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your scrolling text here"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "use_h1",
