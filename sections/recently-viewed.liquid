{% comment %} recently-viewed.liquid 优化后内容 {% endcomment %}

<style>
  .section-id-{{ section.id }} .recently-viewed-wrapper {
    position: relative;
  }
  /* 保持原有图片遮罩效果 */
  .section-id-{{ section.id }} .recently-viewed-box {
    position: relative;
    overflow: hidden;
  }
  
  .section-id-{{ section.id }} .recently-viewed-box::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.05);
    mix-blend-mode: multiply;
    z-index: 2;
    pointer-events: none;
  }

  .section-id-{{ section.id }} .recently-viewed-box .image-cont {
    position: relative;
  }

  .section-id-{{ section.id }} .recently-viewed-box .product-block__image img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  
  .section-id-{{ section.id }} .product-info {
    color: #100f0f;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
  }

  .section-id-{{ section.id }} .recently-viewed-card .product-link {
    text-decoration: none;
    color: inherit;
  }

  .section-id-{{ section.id }} .recently-viewed-card .image-page-button {
    z-index: 3;
  }
  
  .section-id-{{ section.id }} .product-price {
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
  
  .section-id-{{ section.id }} .product-price__compare {
    opacity: 0.6;
    text-decoration: line-through;
    font-size: 0.9em;
  }
  
  .section-id-{{ section.id }} .product-block__title {
    text-align: left;
    width: 100%;
    margin-bottom: 8px;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  
  
  /* 新增：轮播导航按钮样式 */
  .section-id-{{ section.id }} .hometitle {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }  
  
  @media (min-width: 768px) {
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-nav {
      position: absolute;
      width: 100%;
      top: 40%;
      z-index: 9;
      transform: translateY(-50%);
    }
    
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-prev,.section-id-{{ section.id }} .recently-viewed-wrapper .owl-next {
      position: absolute;
      opacity: 0;
      transition: all 0.3s linear 0s;
    }
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-prev {
      left: -30px;
    }
    
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-next {
      right: -30px;
    }
    .section-id-{{ section.id }} .owl-nav button {
        display: inline-block;
        color: rgb(61, 58, 51);
        background: rgb(248, 248, 255);
        border-radius: 50%;
        border: 0.5px solid rgb(153, 153, 153);
        height: 50px;
        width: 50px;
        line-height: 20px;
        font-size: 35px;
    }
    .section-id-{{ section.id }} .recently-viewed-wrapper:hover .owl-nav .owl-prev {
      transform: translate(30px,0);
      opacity: 0.9;
      transition: 0.3s linear;
    }
    .section-id-{{ section.id }} .recently-viewed-wrapper:hover .owl-nav .owl-next {
      transform: translate(-30px,0);
      opacity: 0.9;
      transition: 0.3s linear;
    }
    .section-id-{{ section.id }} .owl-nav button:hover {
      opacity: 1;
    }
  }
  @media (max-width: 767px) { 
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-nav  {
      position: absolute;
      top: 0;
      width: 100%;
    }
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-prev,.section-id-{{ section.id }} .recently-viewed-wrapper .owl-next {
      position: absolute;
    }
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-prev {
      left: 0px;
    }
    
    .section-id-{{ section.id }} .recently-viewed-wrapper .owl-next {
      right: 0px;
    }
  }
</style>

<div class="section-id-{{ section.id }}">
  <div class="container fully-spaced-row">
    <div class="recently-viewed-wrapper page-width">
      <div class="hometitle align-center has-paging" {%- render 'animation-attrs', attrs: 'data-cc-animate data-cc-animate-delay="0.3s"' -%}>
        <h2 class="has-paging__title h4 m-0">{{ section.settings.heading }}</h2>
        <div class="owl-nav"></div>
      </div>
      <div class="recently-viewed-carousel owl-carousel owl-theme carousel"></div>
    </div>
  </div>
</div>

<script>
  class RecentProducts {
    constructor() {
      this.storageKey = 'recentlyViewedProducts';
      this.maxProducts = {{ section.settings.product_limit | default: 8 }};
      this.currentProduct = {
        id: '{{ product.id }}',
        handle: '{{ product.handle }}',
        title: '{{ product.title | escape }}',
        image: '{{ product.featured_media | image_url: width: 800 }}',
        price: '{{ product.price | money }}',
        comparePrice: '{{ product.compare_at_price | money }}',
        url: '{{ product.url }}',
        imageAlt: '{{ product.featured_media.alt | escape }}',
        images: [
          {%- for image in product.images -%}
            {
              "src": {{ image | image_url: width: 800 | json }},
              "alt": {{ image.alt | default: product.title | escape | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      };
      this.carouselConfig = {
        margin: 20,
        nav: true, // 启用轮播导航按钮
        navText: [
          '<span class="px-1 slider-nav__btn has-ltr-icon">{% render 'icon-chevron-left' %}</span>', // 使用更优雅的左箭头
          '<span class="px-1 slider-nav__btn has-ltr-icon">{% render 'icon-chevron-right' %}</span>'  // 使用更优雅的右箭头
        ],
        dots: false,
        responsive: {
          0: { items: 2, margin: 10 },
          768: { items: 3 },
          1024: { items: 4 },
          1200: { items: 5 }
        }
      };
    }

    updateStorage() {
      if (!this.currentProduct.id) return;
      
      let products = JSON.parse(localStorage.getItem(this.storageKey)) || [];
      
      // 过滤掉当前产品，避免重复
      products = products.filter(p => p.id !== this.currentProduct.id);
      
      // 只在产品页面更新存储
      if (window.location.pathname.includes('/products/')) {
        products.unshift(this.currentProduct);
      }

      // 保持最多8个产品
      if (products.length > this.maxProducts) {
        products = products.slice(0, this.maxProducts);
      }
      
      localStorage.setItem(this.storageKey, JSON.stringify(products));
      
      // 触发产品更新事件
      document.dispatchEvent(new CustomEvent('recentProductsUpdated', {
        detail: { products }
      }));
    }

    escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str == null ? '' : String(str);
      return div.innerHTML;
    }

    // 兼容老数据：若缓存里只有首图，自动补成图片数组格式
    normalizeProduct(product) {
      const normalized = { ...product };
      if (!Array.isArray(normalized.images) || normalized.images.length === 0) {
        normalized.images = normalized.image ? [{ src: normalized.image, alt: normalized.imageAlt || normalized.title || '' }] : [];
      }
      if (!normalized.url && normalized.handle) {
        normalized.url = `/products/${normalized.handle}`;
      }
      return normalized;
    }

    async enrichProductsWithImages(products) {
      const tasks = products.map(async (product) => {
        const item = this.normalizeProduct(product);
        if (item.images.length > 1 || !item.handle) return item;

        try {
          const res = await fetch(`/products/${item.handle}.js`);
          if (!res.ok) return item;
          const data = await res.json();
          if (Array.isArray(data.images) && data.images.length > 0) {
            item.images = data.images.map((src) => ({
              src: src,
              alt: item.title || ''
            }));
            item.image = item.images[0].src;
          }
        } catch (e) {
          // 网络失败时保持当前缓存数据，不阻断渲染
        }
        return item;
      });

      return Promise.all(tasks);
    }

    initCarousel() {
      const products = JSON.parse(localStorage.getItem(this.storageKey)) || [];
      const $carousel = $('.recently-viewed-carousel');
      
      // 移除轮播图默认生成的导航按钮容器
      $carousel.find('.owl-nav').remove();
      
      // 根据产品数量动态配置轮播
      const config = { ...this.carouselConfig };
      config.loop = products.length > 4; // 只有产品数量超过4个时启用循环
      
      // 初始化轮播，并指定使用hometitle中的导航按钮容器
      $carousel.owlCarousel({
        ...config,
        navContainer: '.hometitle .owl-nav'
      });
    }

    renderImageSlides(product) {
      const images = product.images || [];
      if (!images.length) return '';

      return images.map((img, index) => {
        // 复用主题 ProductBlock 的图片状态机：
        // - 第 1 张：active
        // - 第 2 张：show-on-hover（并默认 inactivated，由主题脚本延迟移除以做 hover 预载）
        // - 其它：inactivated（首次交互/鼠标进入后主题脚本会统一激活）
        let stateClass = '';
        if (index === 0) stateClass = 'product-block__image--active';
        else if (index === 1) stateClass = 'product-block__image--show-on-hover product-block__image--inactivated';
        else stateClass = 'product-block__image--inactivated';
        return `
          <div class="product-block__image ${index === 0 ? 'product-block__image--primary' : 'product-block__image--secondary'} ${stateClass}" data-image-index="${index}">
            <img src="${this.escapeHtml(img.src)}" alt="${this.escapeHtml(img.alt || product.title || '')}" loading="lazy">
          </div>
        `;
      }).join('');
    }

    renderImageButtons(product) {
      if (!product.images || product.images.length < 2) return '';
      return `
        <a class="image-page-button image-page-button--previous has-ltr-icon" href="#" aria-label="Previous image" tabindex="-1">{% render 'icon-chevron-left', stroke_width: 1.3 %}</a>
        <a class="image-page-button image-page-button--next has-ltr-icon" href="#" aria-label="Next image" tabindex="-1">{% render 'icon-chevron-right', stroke_width: 1.3 %}</a>
      `;
    }

    renderCard(product) {
      return `
        <div class="item">
          <product-block class="product-block recently-viewed-card">
            <div class="block-inner">
              <div class="block-inner-inner">
                <div class="recently-viewed-box image-cont ${product.images && product.images.length > 1 ? 'image-cont--with-secondary-image' : ''}">
                  <a href="${this.escapeHtml(product.url)}" class="product-link" aria-label="${this.escapeHtml(product.title)}">
                    <div class="image-label-wrap">
                      <div>
                        ${this.renderImageSlides(product)}
                      </div>
                    </div>
                  </a>
                  ${this.renderImageButtons(product)}
                </div>
                <div class="product-info">
                  <a href="${this.escapeHtml(product.url)}" class="product-link">
                    <div class="product-block__title">${this.escapeHtml(product.title)}</div>
                    ${this.renderPrice(product)}
                  </a>
                </div>
              </div>
            </div>
          </product-block>
        </div>
      `;
    }

    async renderProducts() {
      const container = document.querySelector('.recently-viewed-carousel');
      if (!container) return;

      const rawProducts = JSON.parse(localStorage.getItem(this.storageKey)) || [];
      const products = await this.enrichProductsWithImages(rawProducts);
      localStorage.setItem(this.storageKey, JSON.stringify(products));
      
      // 清空容器并销毁可能存在的轮播实例
      const $carousel = $(container);
      if ($carousel.data('owl.carousel')) {
        $carousel.trigger('destroy.owl.carousel');
        // 不要移除 owl-carousel 类，否则会影响 Owl 的 display / 初始化状态
        $carousel.removeClass('owl-loaded');
        $carousel.find('.owl-stage-outer').children().unwrap();
        $carousel.removeData();
      }

      // 检查是否有产品需要显示
      if (products.length === 0) {
        container.innerHTML = '<div class="text-center py-10"><p>No products viewed recently</p></div>';
        return;
      }

      // 生成更贴近主题产品卡片结构的 HTML，支持多图切换
      container.innerHTML = products.map(product => this.renderCard(product)).join('');

      // 初始化轮播
      this.initCarousel();
    }

    renderPrice(product) {
      return `
        <div class="product-price">
          <span class="product-price__amount">${product.price}</span>
          ${this.isValidComparePrice(product) ? 
            `<span class="product-price__compare">${product.comparePrice}</span>` : ''}
        </div>
      `;
    }
    
    // 验证比较价格是否有效
    isValidComparePrice(product) {
      if (!product.comparePrice) return false;
      
      // 提取价格数值
      const currentPrice = parseFloat(product.price.replace(/[^0-9.]/g, ''));
      const comparePrice = parseFloat(product.comparePrice.replace(/[^0-9.]/g, ''));
      
      // 比较价格必须大于当前价格才有效
      return comparePrice > currentPrice && comparePrice > 0;
    }

    async init() {
      // 只在产品页面更新存储
      if (window.location.pathname.includes('/products/')) {
        this.updateStorage();
      }
      
      // 初始渲染产品
      await this.renderProducts();
      
      // 监听产品更新事件，用于页面内其他组件响应
      document.addEventListener('productViewed', async () => {
        this.updateStorage();
        await this.renderProducts();
      });
      
      // 监听页面加载完成事件，用于异步内容加载后的更新
      document.addEventListener('DOMContentLoaded', async () => {
        await this.renderProducts();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const recentProducts = new RecentProducts();
    await recentProducts.init();
    
    // 确保Owl Carousel加载完成后再初始化
    if (typeof $.fn.owlCarousel !== 'function') {
      console.error('Owl Carousel is not loaded');
      return;
    }
  });
</script>

{% schema %}
{
  "name": "Recently Viewed Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum Products to Show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed Products",
      "category": "Custom"
    }
  ]
}
{% endschema %}