<style>
    ul li {
      list-style: none;
    }
  @media (min-width: 768px) {
  .section-id-{{ section.id }}  .content .content-list{
      max-width:1000px;
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      margin: 53px auto 0;
    }
    .section-id-{{ section.id }}  .content ul.dashed-line::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      width: 1px;
      height: 100%;
      margin: auto;
      border-left: 1px dashed #000;
    }
    .section-id-{{ section.id }}  .content .content-list .content-list-item{
      width: 440px;
      margin-bottom:6em;
      padding-bottom: 30px;
      position: relative;
    }
  }
  .section-id-{{ section.id }}  .content .content-list .content-list-item>a{
      width: 100%;
      display: block;
    }
    .section-id-{{ section.id }} .content .content-list li.dashed-line::after{
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      margin: auto;
      width: 100%;
      height: 1px;
      border-bottom: 1px dashed #000;
    }
@media (max-width: 767px) {
  .section-id-{{ section.id }}  .content .content-list .content-list-item{
      width: 100%;
      margin-bottom:4em;
      padding-bottom: 3rem;
      position: relative;
  }
  .section-id-{{ section.id }} .content .content-list {
    /* margin-left: 1em; */
    padding: 0 1rem;
  }
  .section-id-{{ section.id }} .content .content-list .content-list-item:first-child{
    padding-top:2em;
  }
  .section-id-{{ section.id }} .content .content-list li.content-list-item:first-child::before{
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    margin: auto;
    width: 87.7333333333vw;
    height: 1px;
    border-bottom: 1px dashed #000;
  }
}
.section-id-{{ section.id }} .content .content-list .content-list-item .info{
  text-align: center;
}
.section-id-{{ section.id }} .content .content-list .content-list-item .info p,.section-id-{{ section.id }} .content .content-list .content-list-item .info span {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.4;
  color: #000;
  transition: color .1s linear;
}
.section-id-{{ section.id }} .content .content-list .content-list-item .info .small-text{
  font-size: 12px;
  color: #919191;
}
.section-id-{{ section.id }} .content .content-list .content-list-item .info .more{
    margin-top: 12px;
    padding: 0 14px;
    width: auto;
    height: 24px;
    display: inline-block;
    line-height: 21px;
    border: 1px solid #000;
    box-sizing: border-box;
    border-radius: 12px;
    transition: color .23s,background-color .23s 50ms,border .23s 50ms;
}
.section-id-{{ section.id }} .content .content-list .content-list-item>a:hover .more{
  border: 1px solid {{ section.settings.info_color }};
  color: #fff;
  background-color: {{ section.settings.info_color }};
}
.section-id-{{ section.id }} .content .content-list .content-list-item>a:hover .big-text{
  color: {{ section.settings.info_color }};
}
.section-id-{{ section.id }} .content .content-list .content-list-item>a:hover .small-text{
  color: {{ section.settings.info_color }};
}
.section-id-{{ section.id }} .content .content-list .content-list-item .info p{
  margin-bottom: 4px;
}
.section-id-{{ section.id }} .content .content-list .content-list-item .info .big-text{
  margin-top: 10px;
}

</style>
<div class="section-id-{{ section.id }}">
  <div class="content">
    <ul class="content-list {% if section.settings.hide_dashed_line %}dashed-line{% endif %}">
      {%- for block in section.blocks -%}
      <li class="content-list-item {% if section.settings.hide_dashed_line %}dashed-line{% endif %}">
        <a href="{{ block.settings.image_link }}">
          <div class="image">
          {%- if block.settings.image == blank -%}        
            <div class="placeholder-image">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- else -%}
           <img src="{{ block.settings.image |  image_url: width: 450,height:480 }}" loading="lazy">
          {%- endif -%}
          <div class="info">
            <p class="big-text">{{ block.settings.title_big }}</p>
            <p class="small-text">{{ block.settings.title_small }}</p>
            <span class="more">{{ block.settings.more_b }}</span>
           </div>
          </div>
        </a>
      </li>
      {% endfor %}
    </ul>

  </div>
</div>

{% schema %}
  {
    "name": "Image block",
    "settings": [
      {
      "id": "hide_dashed_line",
      "type": "checkbox",
      "label": "显示虚线",
      "default": true
      },
      {
          "type": "color",
          "id": "info_color",
          "label": "background color",
          "default": "#ec4111"
      }
    ],
   "blocks":[
     {
     "type": "image",
     "name": "Image",
     "settings": [
       {
         "type": "image_picker",
         "id": "image",
         "label": "Image"
       },
       {
           "type": "url",
           "id": "image_link",
           "label": "Image link"
       },
       {
            "type": "text",
            "id": "title_big",
            "label": "title"
        },
        {
              "type": "text",
              "id": "title_small",
              "label": "subtitle"
        },
        {
              "type": "text",
              "id": "more_b",
              "label": "Button information",
              "default": "View More"
        }
     ]
     }
   ],
   "presets":[
        {
         "name":"Image block",
         "blocks": [
       {
         "type": "image"
       },
       {
         "type": "image"
       }
     ]
        }
]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}