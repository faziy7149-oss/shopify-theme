{% style %}
  .section-id-{{ section.id }} #data-tit-col {
     color: {{ section.settings.countdown_text_col }};
   }
  .section-id-{{ section.id }} #day {
          color:{{ section.settings.countdown_day_fcol }};
          background-color:{{ section.settings.countdown_day_bcol }};
  }
  .section-id-{{ section.id }} .count-customize-bg #data-bg-col {
          background-color:{{ section.settings.countdown_wei_bcol }}
  }
  .section-id-{{ section.id }} .count-customize-bg {
    background: {{ section.settings.countdown_wei_bcol }};
  }
  .section-id-{{ section.id }} .clock-con .time-item-num {
          color:{{ section.settings.countdown_time_col }}
  }
  .count-down-box .time-item-colon{
    font-size: 40px;
    position: absolute;
    top: -6px;
    right: -12px;
    color:{{ section.settings.countdown_time_col }}
  }

  .section-id-{{ section.id }} .count-customize-bg .time-item-text {
    font-size: 12px;
    margin-top: -10px;
    color:{{ section.settings.countdown_time_col }};
  }
  .section-id-{{ section.id }} .count-down-box .time-item-text {
    font-size: 12px;
    margin-top: -18px;
    color:{{ section.settings.countdown_time_col }};
  }
   .section-id-{{ section.id }} .count-shop-now-link {
    text-align: center;
    height: 50px;
    max-width: 100%;
    overflow: hidden;
    margin-top: 20px;
    margin-left: 7em;
    padding: 10px 30px;
    border: 1px solid {{ section.settings.countdown_time_col }};
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.104, 0.204, 0.492, 1);
  }
  .section-id-{{ section.id }}  .count-shop-now-link >  .count-shop-now {
    color: {{ section.settings.countdown_time_col }};
    vertical-align: middle;
    display: inline-block;
  }
  .section-id-{{ section.id }}  .count-shop-now-link:after {
    content: '';
    display: block;
    width: 300%;
    height: 60px;
    margin: -42px 0 0 -35px;
    background: transparent;
    transition: all 0.25s cubic-bezier(0.104, 0.204, 0.492, 1);
  }
  .section-id-{{ section.id }}  .count-shop-now-link:hover::after {
    background: {{ section.settings.countdown_time_col }};
  }
   .section-id-{{ section.id }} .count-shop-now-link:hover > .count-shop-now {
    color: {{ section.settings.countdown_wei_bcol }};
  }
  .section-id-{{ section.id }} .container--no-max {
    padding-right: 0;
    padding-left: 0;
  }
/* 倒计时 countdown.liquid */
