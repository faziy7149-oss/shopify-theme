{% endstyle %}

{% if section.settings.countdown_cbox %}
<div class="section-id-{{ section.id }}">
  <div class="container count-down-outer {% if section.settings.count_down_center %}count-down-outer2{% endif %} {% if section.settings.full_width %} container--no-max{% endif %}">
    <div class="{% if section.settings.countdown_customize_css %} count-customize-bg {% endif %} count-down-box {% if section.settings.count_down_center %}count-down-center count-down-m{% endif %}">
      <div class="data-count-box">
        <h3 class="count-down-title" id="data-tit-col">{{ section.settings.countdown_title }}</h3>
        <div class="clock-con {% if section.settings.count_down_center %}count-down-clock-con{% endif %}">
          <div class="day-box {% if section.settings.top_left_day %} count-down-day{% endif %}" id="day">
            <span id="day-num">123</span>Day
          </div>
          <div class="time-item" id="hour">
            <div class="time-item-bg" id="data-bg-col"></div>
            <div class="time-item-num" id="hour-num">12</div>
            {% if section.settings.countdown_customize_css %}
              <div class="time-item-text">HOURS</div>
            {% endif %}
            <span class="time-item-colon">:</span>
          </div>
          <div class="time-item" id="min">
            <div class="time-item-bg" id="data-bg-col"></div>
            <div class="time-item-num" id="min-num">12</div>
            {% if section.settings.countdown_customize_css %}
              <div class="time-item-text">MINUTES</div>
            {% endif %}
            <span class="time-item-colon">:</span>
          </div>
          <div class="time-item" id="sec">
            <div class="time-item-bg" id="data-bg-col"></div>
            <div class="time-item-num" id="sec-num">00</div>
            {% if section.settings.countdown_customize_css %}
              <div class="time-item-text">SECONDS</div>
            {% endif %}
          </div>
        </div>
        {% if section.settings.countdown_customize_css %}
          {% if section.settings.count_down_link_text != blank %}
            <a class="count-shop-now-link" href="{{ section.settings.count_down_link }}">
              <div class="count-shop-now">{{ section.settings.count_down_link_text }}</div>
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="deadline-box">
    截止时间：
    <span class="deadline-str-box" id="deadline-str"></span>
  </div>
  <div class="edit-box">
    <input type="text" placeholder="xxxx-xx-xx" id="edit-deadline" value="{{section.settings.countdown_time}}">
  </div>
</div>
{% endif %}

{% schema %}
{
"name": "Countdown",
"settings": [
  {
    "id": "countdown_time",
    "type": "text",
    "label": "2099/12/31,23:00"
  },
  {
    "type": "checkbox",
    "id": "countdown_cbox",
    "label": "开启定时器",
    "default": false
  },
  {
    "type": "checkbox",
    "id": "countdown_customize_css",
    "label": "开启自定义样式",
    "default": true
  },
  {
    "type": "color",
    "id": "countdown_text_col",
    "label": "Countdown Title Color",
    "default": "#000000"
  },
  {
    "type": "color",
    "id": "countdown_day_bcol",
    "label": "Countdown Day BackgrundColor",
    "default": "#D3D3D3"
  },
  {
    "type": "color",
    "id": "countdown_day_fcol",
    "label": "Countdown Day FontColor",
    "default": "#000000"
  },
  {
    "type": "color",
    "id": "countdown_wei_bcol",
    "label": "背景颜色",
    "default": "#A20000"
  },
  {
    "type": "color",
    "id": "countdown_time_col",
    "label": "Countdown Time FontColor",
    "default": "#FFFFFF"
  },
  {
    "id": "countdown_title",
    "type": "text",
    "label": "Timer Name",
    "default": "Weekly Sale"
  },
  {
    "type": "checkbox",
    "id": "top_left_day",
    "label": "Top left corner days switch",
    "info": "关闭左上角天数的开关",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "count_down_center",
    "label": "Countdown is centered",
    "info": "倒计时居中",
    "default": true
  },
  {
    "type": "url",
    "id": "count_down_link",
    "label": "Countdown link",
    "info": "倒计时链接"
  },
  {
    "type": "text",
    "id": "count_down_link_text",
    "label": "购买按钮文本",
    "default": "SHOP NOW"
  },
  {
      "id": "full_width",
      "type": "checkbox",
      "label": "Full page width",
      "default": true
  }
],
"presets": [
  {
    "name": "Countdown",
    "settings": {}
  }
]
}
{% endschema %}

<script>
function dataCountdown() {
  const hourBox = document.getElementById('hour-num');
  const minBox = document.getElementById('min-num');
  const secBox = document.getElementById('sec-num');
  const deadlineStrBox = document.getElementById('deadline-str');
  const editDeadline = document.getElementById('edit-deadline');
  const dayBox = document.getElementById('day-num');
  const dayCon = document.getElementById('day');
  let deadline = OutputDeadlineStr(deadlineStrBox);
  let millis = CountDown(deadline, hourBox, minBox, secBox);
  let timerID = -1;
  if (millis > 0) {
    timerID = setInterval(() => {
      let millis = CountDown(deadline, hourBox, minBox, secBox);
      if (!millis) {
        clearInterval(timerID);
      }
    }, 1000);
  }
  if (editDeadline.value != ' ') {
    var orgValue = editDeadline.value;
    var listenInput;
    function countdownBox() {
      clearTimeout(listenInput);
      var v = editDeadline.value;
      let hourVal = hourBox.innerHTML;
      let minVal = minBox.innerHTML;
      let secVal = secBox.innerHTML;
      if (hourVal == 00 && minVal == 00 && secVal == 00) {
        let countdownOuter = document.getElementsByClassName('count-down-outer')[0];
        let countdownBoxs = document.getElementsByClassName('count-down-box')[0];
        countdownOuter.removeChild(countdownBoxs);
        countdownOuter.style.display = 'none';
      }
      if (v == orgValue) {
        orgValue = v;
        if (editDeadline.value) {
          let dateStr2 = editDeadline.value;
          let dateStr3 = dateStr2.replace(/,/g, ' ');
          let dateStr = dateStr3.replace(/\-/g, '/');
          let newDeadlineDate = new Date(dateStr);
          localStorage.setItem('deadlineDate', newDeadlineDate);
          editDeadline.value = '';
          let deadline = OutputDeadlineStr(deadlineStrBox);
          clearInterval(timerID);
          let millis = CountDown(deadline, hourBox, minBox, secBox);
          if (millis > 0) {
            timerID = setInterval(() => {
              let millis = CountDown(deadline, hourBox, minBox, secBox);
              if (!millis) {
                clearInterval(timerID);
              }
            }, 1000);
          }
        }
      }
      listenInput = setTimeout(countdownBox, 10000);
    }
  }
  countdownBox();

  function OutputDeadlineStr(deadlineStrBox) {
    let deadlineDate = new Date(localStorage.getItem('deadlineDate'));
    let curTime = new Date();
    let deadline = deadlineDate;
    if (!localStorage.getItem('deadlineDate')) {
      deadline = curTime;
      deadlineDate = curTime;
    }
    let dmonth = deadlineDate.getMonth() + 1;
    let dday = deadlineDate.getDate();
    let dhour = deadlineDate.getHours();
    let dmin = deadlineDate.getMinutes();
    let dsec = deadlineDate.getSeconds();
    deadlineStrBox.innerHTML =
      deadlineDate.getFullYear() +
      '年' +
      (dmonth < 10 ? '0' + dmonth : dmonth) +
      '月' +
      (dday < 10 ? '0' + dday : dday) +
      '日' +
      ' ' +
      (dhour < 10 ? '0' + dhour : dhour) +
      ':' +
      (dmin < 10 ? '0' + dmin : dmin) +
      ':' +
      (dsec < 10 ? '0' + dsec : dsec);
    return deadline;
  }
  function CountDown(deadline, hourBox, minBox, secBox) {
    let curTime = new Date();
    let millis = deadline - curTime;
    millis = millis < 0 ? 0 : millis;
    let day = parseInt(millis / 1000 / 60 / 60 / 24);
    let hour = parseInt(millis / 1000 / 60 / 60);
    let min = parseInt((millis / 1000 / 60) % 60);
    let sec = parseInt((millis / 1000) % 60);
    hourBox.innerHTML = hour < 10 ? '0' + hour : hour;
    minBox.innerHTML = min < 10 ? '0' + min : min;
    secBox.innerHTML = sec < 10 ? '0' + sec : sec;
    if (day > 0) {
      dayBox.innerHTML = day;
      dayCon.style.visibility = 'visible';
    } else {
      dayCon.style.visibility = 'hidden';
    }
    return millis;
  }
}
dataCountdown();
document.addEventListener('shopify:section:load', function (event) {
  dataCountdown();
});
</script>
