{% comment %}
  ========== Advertising 活动：前端脚本 ==========
  1. 到期隐藏整块 .advertising-box
  2. 接管主题 countdown-timer，改为总小时显示（如 48:50:55），不修改 countdown-timer.liquid / .js 源文件逻辑依赖
  仅作用于 Advertising 模块，不影响站内其他倒计时
{% endcomment %}
<script>
  /* ========== Advertising 活动：倒计时接管 + 到期隐藏 ========== */
  (function () {
    function pad2(n) {
      return n < 10 ? '0' + n : String(n);
    }

    /* Advertising 活动：停用主题计时器，改为总小时:分:秒 */
    function takeOverAdCountdown(timer, box, end) {
      if (timer.dataset.adHoursBound) return;
      timer.dataset.adHoursBound = 'true';

      function disableThemeTimer() {
        if (timer.interval) {
          clearInterval(timer.interval);
          timer.interval = null;
        }
        timer.timer = function () {};
      }

      disableThemeTimer();

      var hoursEl = timer.querySelector('.js-hours');
      var minsEl = timer.querySelector('.js-mins');
      var secsEl = timer.querySelector('.js-secs');

      function tick() {
        disableThemeTimer();

        hoursEl = hoursEl || timer.querySelector('.js-hours');
        minsEl = minsEl || timer.querySelector('.js-mins');
        secsEl = secsEl || timer.querySelector('.js-secs');

        var diff = end - Date.now();
        if (diff <= 0) {
          box.style.display = 'none';
          return false;
        }

        var totalHours = Math.floor(diff / 3600000);
        var mins = Math.floor((diff % 3600000) / 60000);
        var secs = Math.floor((diff % 60000) / 1000);

        if (hoursEl) hoursEl.textContent = pad2(totalHours);
        if (minsEl) minsEl.textContent = pad2(mins);
        if (secsEl) secsEl.textContent = pad2(secs);

        timer.setAttribute('loaded', '');
        return true;
      }

      tick();
      var timerId = setInterval(function () {
        if (!tick()) clearInterval(timerId);
      }, 1000);
    }

    /* Advertising 活动：初始化匹配模块的倒计时与到期隐藏 */
    function initAdvertisingCountdowns(root) {
      var boxes = (root || document).querySelectorAll('.advertising-box[data-countdown-end]');
      boxes.forEach(function (box) {
        if (box.dataset.adCountdownBound) return;
        box.dataset.adCountdownBound = 'true';

        var end = new Date(box.getAttribute('data-countdown-end')).getTime();
        if (!Number(end)) return;

        if (Date.now() >= end) {
          box.style.display = 'none';
          return;
        }

        var timer = box.querySelector('countdown-timer');
        if (!timer) {
          var hideId = setInterval(function () {
            if (Date.now() >= end) {
              clearInterval(hideId);
              box.style.display = 'none';
            }
          }, 1000);
          return;
        }

        function startWhenReady() {
          takeOverAdCountdown(timer, box, end);
        }

        if (timer.hasAttribute('loaded') || timer.interval) {
          startWhenReady();
          return;
        }

        var observer = new MutationObserver(function () {
          if (timer.hasAttribute('loaded') || timer.interval) {
            observer.disconnect();
            startWhenReady();
          }
        });
        observer.observe(timer, { attributes: true, attributeFilter: ['loaded'] });

        setTimeout(function () {
          observer.disconnect();
          startWhenReady();
        }, 2500);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initAdvertisingCountdowns();
      });
    } else {
      initAdvertisingCountdowns();
    }

    document.addEventListener('shopify:section:load', function (event) {
      initAdvertisingCountdowns(event.target);
    });
  })();
  /* ========== END Advertising 活动：倒计时接管 + 到期隐藏 ========== */
</script>

{% comment %} 会员积分：变体价格变化时同步积分 {% endcomment %}
<script>
  (function () {
    if (window.__memberPointsBound) return;
    window.__memberPointsBound = true;

    function calcMemberPoints(price, percent, multiplier) {
      var p = Number(percent);
      var m = Number(multiplier);
      if (!Number.isFinite(p) || p < 0) p = 1;
      if (!Number.isFinite(m) || m < 1) m = 1;
      return Math.ceil(Number(price) * p * 0.01 * m);
    }

    function updateMemberPoints(price) {
      document.querySelectorAll('.member-points[data-points-percent]').forEach(function (el) {
        el.textContent = calcMemberPoints(
          price,
          el.getAttribute('data-points-percent'),
          el.getAttribute('data-points-multiplier')
        );
      });
    }

    document.addEventListener('on:variant:change', function (event) {
      var variant = event.detail && event.detail.variant;
      if (!variant || typeof variant.price === 'undefined') return;
      updateMemberPoints(variant.price);
    });
  })();
</script>

