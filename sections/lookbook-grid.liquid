      "default": 1400,
      "info": "Used when Full page width is off"
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Side padding (desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "min": 0,
      "max": 48,
