<!-- /sections/pickup-products.liquid -->

{%- liquid
  case section.settings.image_aspect_ratio
    when 'natural'
      assign pickup_aspect_ratio = blank
    when 'portrait_23'
      assign pickup_aspect_ratio = 0.67
    when 'portrait_45'
      assign pickup_aspect_ratio = 0.8
    when 'landscape_43'
      assign pickup_aspect_ratio = 1.333
    when 'landscape_169'
      assign pickup_aspect_ratio = 1.777
    else
      assign pickup_aspect_ratio = 1.0
  endcase

  assign pickup_object_fit = section.settings.image_object_fit | default: 'cover'
-%}

<div class="pickup-products-section section-{{ section.id }} collection-slider-row for-collections" style="--pickup-gap: {{ section.settings.image_gap }}px; --pickup-section-padding-top: {{ section.settings.padding_top }}px; --pickup-section-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pickup-container container">
    {%- if section.settings.title != blank -%}
      <div class="pickup-section-header hometitle">
        <h2 class="pickup-section-title has-paging__title h4">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="pickup-blocks-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign image_count = 0
          for i in (1..6)
            assign img_key = 'image_' | append: i
            if block.settings[img_key] != blank
              assign image_count = image_count | plus: 1
            endif
          endfor

          assign is_placeholder_mode = false
          if image_count == 0
            assign is_placeholder_mode = true
          endif

          assign effective_image_count = image_count
          if is_placeholder_mode
            assign effective_image_count = 6
          endif

          assign enable_mobile_swiper = false
          if effective_image_count > 3
            assign enable_mobile_swiper = true
          endif
        -%}

        <div class="pickup-block" {{ block.shopify_attributes }}>
          <div class="pickup-block-info">
            {%- if block.settings.sub_title != blank -%}
              <p class="pickup-block-sub-title">{{ block.settings.sub_title }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="pickup-block-title">{{ block.settings.title }}</h3>
            {%- endif -%}
          </div>

          <div
            class="pickup-images-wrapper{% if enable_mobile_swiper %} pickup-images-wrapper--swiper{% endif %}"
            data-pickup-swiper="{{ enable_mobile_swiper }}"
            data-block-id="{{ block.id }}"
          >
            <div class="pickup-images-inner{% if enable_mobile_swiper %} swiper-wrapper{% endif %}">
              {%- for i in (1..6) -%}
                {%- liquid
                  assign img_key = 'image_' | append: i
                  assign price_key = 'price_' | append: i
                  assign link_key = 'link_' | append: i

                  assign product_img = block.settings[img_key]
                  assign product_price = block.settings[price_key]
                  assign product_link = block.settings[link_key]
                -%}

                {%- if is_placeholder_mode or product_img != blank -%}
                  <div class="pickup-product-item{% if i > 3 %} pickup-product-item--mobile-only{% endif %}{% if enable_mobile_swiper %} swiper-slide{% endif %}">
                    {%- if product_link != blank -%}
                      <a href="{{ product_link }}" class="pickup-product-link">
                    {%- else -%}
                      <div class="pickup-product-link">
                    {%- endif -%}
                      <div class="pickup-image-box pickup-image-box--{{ pickup_object_fit }}{% if pickup_aspect_ratio == blank %} pickup-image-box--natural{% endif %}">
                        {%- if is_placeholder_mode -%}
                          {%- if pickup_aspect_ratio != blank -%}
                            <div class="img-ar img-ar--{{ pickup_object_fit }}" style="--aspect-ratio: {{ pickup_aspect_ratio | plus: 0 }}">
                              <div class="pickup-placeholder-viewport" aria-hidden="true">
                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                              </div>
                            </div>
                          {%- else -%}
                            <div class="pickup-placeholder-viewport" aria-hidden="true">
                              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                          {%- endif -%}
                        {%- else -%}
                          {%- if pickup_aspect_ratio != blank -%}
                            {%- render 'image',
                              image: product_img,
                              sizes: '(min-width: 768px) 16vw, 30vw',
                              custom_aspect_ratio: pickup_aspect_ratio,
                              custom_crop: pickup_object_fit,
                              class: 'pickup-product-image'
                            -%}
                          {%- else -%}
                            {%- render 'image',
                              image: product_img,
                              sizes: '(min-width: 768px) 16vw, 30vw',
                              class: 'pickup-product-image pickup-product-image--natural'
                            -%}
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                      {%- if product_price != blank -%}
                        <div class="pickup-product-price">
                          <span class="theme-money">{{ product_price | times: 100 | money }}</span>
                        </div>
                      {%- endif -%}
                    {%- if product_link != blank -%}
                      </a>
                    {%- else -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if block.settings.btn_link != blank -%}
            <div class="pickup-btn-wrapper">
              <a href="{{ block.settings.btn_link }}" class="pickup-btn-desktop">詳細を見る</a>
              <a href="{{ block.settings.btn_link }}" class="small-feature-link">浏览更多</a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .pickup-products-section {
    padding: var(--pickup-section-padding-top, 50px) 0 var(--pickup-section-padding-bottom, 50px);
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  {% comment %} .pickup-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  } {% endcomment %}

  .pickup-section-header {
    text-align: center;
    {% comment %} margin-bottom: 40px; {% endcomment %}
  }

  .pickup-section-title {
    {% comment %} font-size: 28px;
    font-weight: bold; {% endcomment %}
    letter-spacing: 0.05em;
    margin: 0;
  }

  .pickup-blocks-grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -20px;
  }

  .pickup-block {
    width: 50%;
    padding: 0 20px;
    box-sizing: border-box;
    margin-bottom: 50px;
    display: flex;
    flex-direction: column;
  }

  .pickup-block-info {
    margin-bottom: 20px;
  }

  .pickup-block-sub-title {
    font-size: 12px;
    color: #333;
    margin: 0 0 5px 0;
    line-height: 1.5;
  }

  .pickup-block-title {
    font-size: 18px;
    font-weight: bold;
    color: #000;
    margin: 0;
    line-height: 1.4;
  }

  .pickup-images-wrapper {
    width: 100%;
  }

  .pickup-images-inner {
    display: flex;
    gap: var(--pickup-gap, 12px);
  }

  .pickup-product-item {
    flex: 0 0 calc((100% - (var(--pickup-gap, 12px) * 2)) / 3);
    min-width: 0;
  }

  .pickup-product-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .pickup-image-box {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f7f7f7;
  }

  .pickup-placeholder-viewport {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f7f7f7;
  }

  .pickup-placeholder-viewport svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .img-ar .pickup-placeholder-viewport {
    position: absolute;
    inset: 0;
  }

  .pickup-image-box .img-ar {
    width: 100%;
  }

  .pickup-image-box--natural {
    aspect-ratio: auto;
  }

  .pickup-image-box--natural .pickup-product-image--natural,
  .pickup-image-box--natural .global-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .pickup-image-box--cover .global-image,
  .pickup-image-box--contain .global-image {
    transition: transform 0.3s ease;
  }

  {% comment %} .pickup-product-link:hover .pickup-image-box--cover .global-image,
  .pickup-product-link:hover .pickup-image-box--contain .global-image,
  .pickup-product-link:hover .pickup-image-box--natural .global-image {
    transform: scale(1.03);
  } {% endcomment %}

  .pickup-product-price {
    margin-top: 8px;
    font-size: 13px;
    color: #333;
    line-height: 1.4;
  }

  .pickup-btn-wrapper {
    margin-top: 25px;
    text-align: center;
  }

  .pickup-btn-desktop {
    display: inline-block;
    min-width: 240px;
    padding: 12px 30px;
    border: 1px solid #ccc;
    background: #fff;
    color: #333;
    text-align: center;
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .pickup-btn-desktop:hover {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .pickup-link-mobile {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .pickup-blocks-grid {
      margin: 0;
    }

    .pickup-block {
      width: 100%;
      padding: 0;
      margin-bottom: 45px;
    }

    .pickup-block:last-child {
      margin-bottom: 0;
    }

    .pickup-product-item--mobile-only {
      display: block;
    }

    .pickup-images-wrapper:not(.pickup-images-wrapper--swiper) {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y;
      overscroll-behavior-x: contain;
    }

    .pickup-images-wrapper:not(.pickup-images-wrapper--swiper)::-webkit-scrollbar {
      display: none;
    }

    .pickup-images-wrapper:not(.pickup-images-wrapper--swiper) .pickup-images-inner {
      min-width: 100%;
    }

    .pickup-images-wrapper--swiper {
      overflow: hidden;
      touch-action: pan-y pinch-zoom;
    }

    .pickup-images-wrapper--swiper .pickup-images-inner {
      gap: 0;
    }

    .pickup-images-wrapper--swiper .pickup-product-item {
      flex: none;
      width: auto;
    }

    .pickup-btn-wrapper {
      margin-top: 20px;
      text-align: center;
    }

    .pickup-btn-desktop {
      display: none;
    }
  }

  @media screen and (min-width: 768px) {
    .pickup-product-item--mobile-only {
      display: none;
    }
    .pickup-btn-wrapper .small-feature-link {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var sectionRoot = document.querySelector('.section-{{ section.id }}');
    if (!sectionRoot || typeof Swiper === 'undefined') return;

    var MOBILE_BREAKPOINT = 768;
    var swiperMap = new WeakMap();

    function getGap() {
      var gapValue = getComputedStyle(sectionRoot).getPropertyValue('--pickup-gap').trim();
      var parsed = parseFloat(gapValue);
      return Number.isFinite(parsed) ? parsed : 12;
    }

    function destroySwipers() {
      sectionRoot.querySelectorAll('.pickup-images-wrapper--swiper.swiper-initialized').forEach(function (container) {
        if (container.swiper) {
          container.swiper.destroy(true, true);
        }
        container.classList.remove('swiper');
        swiperMap.delete(container);
      });
    }

    function initSwipers() {
      if (window.innerWidth >= MOBILE_BREAKPOINT) {
        destroySwipers();
        return;
      }

      sectionRoot.querySelectorAll('.pickup-images-wrapper--swiper').forEach(function (container) {
        if (container.swiper) return;

        container.classList.add('swiper');

        var swiper = new Swiper(container, {
          direction: 'horizontal',
          slidesPerView: 3.3,
          spaceBetween: getGap(),
          freeMode: true,
          watchOverflow: true,
          nested: false,
          touchStartPreventDefault: false,
          touchMoveStopPropagation: false,
          touchReleaseOnEdges: true,
          threshold: 8,
          touchAngle: 45
        });

        swiperMap.set(container, swiper);
      });
    }

    var resizeTimer;
    function handleResize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(initSwipers, 200);
    }

    initSwipers();
    window.addEventListener('resize', handleResize);
    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.contains(sectionRoot)) {
        initSwipers();
      }
    });
    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target && event.target.contains(sectionRoot)) {
        destroySwipers();
      }
    });
  })();
</script>

