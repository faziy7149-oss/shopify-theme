{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
    assign bg_image_desktop = section.settings.image | image_url: width: 1920
    assign bg_image_mobile = section.settings.image | image_url: width: 900
  endif

  assign solid_bg = section.settings.background_color | default: section.settings.background_color_overlay

  if section.settings.show_overlay
    assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
    assign overlay_fill = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
  endif
-%}

{% style %}
  /* 方案 A：背景直接画在内容容器上，不进页头/页脚，也不拦截点击 */
  #content > .container {
    {%- if has_image -%}
      background-image:
        {%- if section.settings.show_overlay -%}
          linear-gradient({{ overlay_fill }}, {{ overlay_fill }}),
        {%- endif -%}
        url('{{ bg_image_desktop }}');
      background-size: {{ section.settings.bg_size }};
      background-position: {{ section.settings.bg_position }};
      background-repeat: {{ section.settings.bg_repeat }};
      background-attachment: {{ section.settings.bg_attachment }};
    {%- elsif solid_bg != blank -%}
      background: {{ solid_bg }};
    {%- endif -%}
  }

  @media (max-width: 767px) {
    #content > .container {
      {%- if has_image -%}
        background-image:
          {%- if section.settings.show_overlay -%}
            linear-gradient({{ overlay_fill }}, {{ overlay_fill }}),
          {%- endif -%}
          url('{{ bg_image_mobile }}');
        /* iOS 等对 background-attachment: fixed 支持差，移动端强制 scroll */
        background-attachment: scroll;
      {%- endif -%}
    }
  }
{% endstyle %}

{%- comment -%} 本 section 不产生页面高度，仅输出内容区背景样式；每页建议只添加一次。 {%- endcomment -%}
<div class="section-id-{{ section.id }}" {{ section.shopify_attributes }} hidden></div>

{% schema %}
{
  "name": "背景图片",
  "tag": "section",
  "class": "section-background-image",
  "settings": [
    {
      "type": "paragraph",
      "content": "作为内容区底图使用（不含页头/页脚）。每页请只添加一次；本模块本身不占高度。"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "背景图片"
    },
    {
      "type": "header",
      "content": "背景样式"
    },
    {
      "type": "select",
      "id": "bg_size",
      "label": "背景尺寸",
      "options": [
        { "value": "cover", "label": "覆盖" },
        { "value": "contain", "label": "包含" },
        { "value": "auto", "label": "自动" },
        { "value": "100% 100%", "label": "拉伸" }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "bg_repeat",
      "label": "背景重复",
      "options": [
        { "value": "no-repeat", "label": "不重复" },
        { "value": "repeat", "label": "重复" },
        { "value": "repeat-x", "label": "水平重复" },
        { "value": "repeat-y", "label": "垂直重复" }
      ],
      "default": "repeat"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "背景位置",
      "options": [
        { "value": "center", "label": "居中" },
        { "value": "top", "label": "顶部" },
        { "value": "bottom", "label": "底部" },
        { "value": "left", "label": "左侧" },
        { "value": "right", "label": "右侧" },
        { "value": "top left", "label": "左上角" },
        { "value": "top right", "label": "右上角" },
        { "value": "bottom left", "label": "左下角" },
        { "value": "bottom right", "label": "右下角" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "bg_attachment",
      "label": "背景附着",
      "options": [
        { "value": "scroll", "label": "滚动" },
        { "value": "fixed", "label": "固定（仅桌面）" },
        { "value": "local", "label": "局部滚动" }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "背景颜色"
    },
    {
      "type": "color",
      "id": "background_color_overlay",
      "label": "纯色背景",
      "default": "#f5f5f5",
      "info": "未上传图片时使用"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "渐变背景",
      "info": "未上传图片时优先于纯色背景"
    },
    {
      "type": "header",
      "content": "覆盖层设置"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "显示颜色覆盖层",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "覆盖层颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "覆盖层透明度",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Background image",
      "category": "图像"
    }
  ]
}
{% endschema %}
