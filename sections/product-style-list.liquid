{%- liquid
  assign hotspot_color_brightnesss = section.settings.btn_color | color_brightness
-%}
<style>
  .section-id-{{ section.id }} {
    margin: 5em 0;
    --hotspot-colors: {{ section.settings.btn_color.rgb }};
    {%- if hotspot_color_brightnesss > 128 %}
      --hotspot-icon-colors: #111;
    {%- else -%}
      --hotspot-icon-colors: #fff;
    {%- endif %}
    overflow: hidden; /* 防止内容溢出 */
  }
  
  /* 初始隐藏样式 */
  .section-id-{{ section.id }} .swiper:not(.swiper-initialized) {
    opacity: 0;
    height: 0;
    overflow: hidden;
  }
  
  .section-id-{{ section.id }} .swiper-initialized {
    opacity: 1;
    height: auto;
    /* overflow: visible; */
    transition: opacity 0.3s ease;
  }
  
  .section-id-{{ section.id }} .swiper-button-next, 
  .section-id-{{ section.id }} .swiper-button-prev {
    color: rgb(61, 58, 51);
    background: rgb(248, 248, 255);
    border-radius: 50%;
    border: 0.5px solid rgb(153, 153, 153);
    width: 50px;
    height: 50px;
    top: 35%;
    opacity: 0;
    transition: all 0.3s linear 0s;
  }
  
  .section-id-{{ section.id }} .swiper-button-next:after,
  .section-id-{{ section.id }} .swiper-button-prev:after {
    font-size: 15px;
    font-weight: bolder;
  }
  
  .section-id-{{ section.id }} .swiper:hover .swiper-button-next {
    transform: translate(-30px,0);
    opacity: 0.9;
    transition: 0.3s linear;
  }
  
  .section-id-{{ section.id }} .swiper:hover .swiper-button-prev {
    transform: translate(30px, 0);
    opacity: 0.9;
    transition: 0.3s linear;
  }
  
  .section-id-{{ section.id }} .swiper-button-next:hover, 
  .section-id-{{ section.id }} .swiper-button-prev:hover {
    opacity: 1;
  }
  
  .section-id-{{ section.id }} .style-list-title {
    font-size: 20px;
    color: #100f0f;
    font-weight: bold;
    margin-bottom: 1em;
    text-align: center;
  }
  
  .section-id-{{ section.id }} .idol-box{
    position: relative;
  }
  
  .section-id-{{ section.id }} .idol-box .model-info-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    box-shadow: 0 0 0 calc(38px / 4) rgba(var(--hotspot-colors)/.3);
    transition: all .3s cubic-bezier(.4,0,.32,1);
    animation: hotspot-pulsee cubic-bezier(.21,.16,.48,1) 3.5s infinite;
    background-color: rgb(var(--hotspot-colors));
    color: var(--hotspot-icon-colors);
    z-index: 10;
  }
  
  {% for block in section.blocks %}
    .section-id-{{ section.id }} .data-idol-{{ forloop.index }} .idol-box .model-info-btn {
      top: {{ block.settings.top_location }}%;
      left: {{ block.settings.left_location }}%;
    }
    
    @media (max-width: 767px) {
      .section-id-{{ section.id }} .data-idol-{{ forloop.index }} .idol-box .model-info-btn  {
        top: {{ block.settings.top_location2 }}%;
        left: {{ block.settings.left_location2 }}%;
      }
    }
  {% endfor %}

  .section-id-{{ section.id }} .idol-box .model-wrap {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
  }
  
  .section-id-{{ section.id }} .model-info-text {
    width: 70%;
  }
  
  .section-id-{{ section.id }} .idol-box .model-wrap .model-img {
    flex-shrink: 0;
  }
  
  .section-id-{{ section.id }} .idol-box .model-wrap .model-img>img{
    border-radius: 50%;
    width: 58px;
    height: 58px;
    object-fit: cover;
  }
  
  .section-id-{{ section.id }} .idol-box .model-wrap .info-title {
    font-weight: 600;
    color: #000;
    font-size: 15px;
  }
  
  .section-id-{{ section.id }} .idol-box .model-wrap .model-info {
    font-size: 14px;
  }
  
  @keyframes hotspot-pulsee{
    0% {
      box-shadow: 0 0 0 calc(38px / 4) rgba(var(--hotspot-colors) /.3);
    }
    50% {
      box-shadow: 0 0 0 calc(38px / 4) rgba(var(--hotspot-colors) /.3);
    }
    70% {
      box-shadow: 0 0 0 calc(38px / 4 + 6px) rgba(var(--hotspot-colors) /0);
    }
    71% {
      box-shadow: 0 0 0 calc(38px / 4 - 6px) rgba(var(--hotspot-colors) /0);
    }
    100% {
      box-shadow: 0 0 0 calc(38px / 4) rgba(var(--hotspot-colors) /.3);
    }
  }
  
  /* 移动端样式优化 */
  @media (max-width: 768px) {
    .section-id-{{ section.id }} {
      margin: 3em 0;
      padding: 0 5px;
    }
    
    .section-id-{{ section.id }} .container.cf.full-page-width {
      padding: 0;
      width: 100%;
      max-width: 100%;
    }
    
    .section-id-{{ section.id }} .swiper {
      width: 100%;
    }
    
    .section-id-{{ section.id }} .swiper-wrapper {
      width: 100%;
    }
    
    .section-id-{{ section.id }} .swiper-slide {
      width: 85% !important;
      margin: 0 7.5%;
    }
    
    .section-id-{{ section.id }} .idol-box>img {
      border-radius: 6px;
      width: 100%;
      height: auto;
    }
    
    .section-id-{{ section.id }} .swiper-button-prev, 
    .section-id-{{ section.id }} .swiper-button-next{
      display: none;
    }
    
    .section-id-{{ section.id }} .model-info-text {
      width: 100%;
      text-align: center;
      margin-top: 10px;
    }
    
    .section-id-{{ section.id }} .model-wrap {
      flex-direction: column;
      align-items: center;
    }
  }
  
  /* 防止全局溢出 */
  body {
    overflow-x: hidden;
    width: 100%;
  }
</style>

<div class="section-id-{{ section.id }}">
  <div class="container cf full-page-width">
    <div class="style-list-title align-center">{{ section.settings.title }}</div>
    <div class="swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide data-idol-{{ forloop.index }}">
            <div class="idol-box">
              {% if block.settings.idol_img == blank %}
                <div class="placeholder-image">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% else %}
                {% render 'image' with block.settings.idol_img,
                  sizes: '2800px',
                  class: 'swiper-lazy',
                  loading: 'lazy'
                %}
              {% endif %}
              {% if block.settings.product_url != blank %}
                <a href="{{ block.settings.product_url }}">
                  <div class="model-info-btn">
                    {% render 'icon-plus' %}
                  </div>
                </a>
              {% endif %}
              <div class="model-wrap">
                <div class="model-img">
                  {% if block.settings.model_img == blank %}
                    <div class="placeholder-image" style="width: 68px; height: 68px; padding-top: 0; border-radius: 50%;">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% else %}
                    {% render 'image' with block.settings.model_img,
                      sizes: '2800px',
                      class: 'swiper-lazy',
                      loading: 'lazy'
                    %}
                  {% endif %}
                </div>
                <div class="model-info-text">
                  <div class="info-title">{{ block.settings.model_name }}</div>
                  <div class="model-info">
                    <span class="model_height">{{ block.settings.model_height }}</span>
                    <span class="model_weight">{{ block.settings.model_weight }}</span>
                    <span class="model_size">{{ block.settings.model_size }}</span>
                    <span class="model_comfort">{{ block.settings.model_comfort }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.list_url %}
        <a class="small-feature-link" style="text-align: center; display: inline-block; width: 100%; margin-top: 20px;" href="{{ section.settings.list_url }}">{{ section.settings.url_text }}</a>
      {% endif %}
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // 在初始化前隐藏轮播
    $('.section-id-{{ section.id }} .swiper').css('opacity', 0);
    
    var mySwiper = new Swiper('.section-id-{{ section.id }} .swiper', {
      loop: true,
      slidesPerView: 5,
      spaceBetween: 10,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      on: {
        init: function () {
          // 初始化完成后显示轮播
          $('.section-id-{{ section.id }} .swiper').css('opacity', 1).addClass('swiper-initialized');
        }
      },
      breakpoints: {
        320: {
          slidesPerView: 1,
          spaceBetween: 10,
          centeredSlides: true,
        },
        480: {
          slidesPerView: 1.2,
          spaceBetween: 15,
          centeredSlides: true,
        },
        640: {
          slidesPerView: 1.5,
          spaceBetween: 15,
          centeredSlides: false,
        },
        768: {
          slidesPerView: 2,
          spaceBetween: 20,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 20,
        },
        1280: {
          slidesPerView: 4,
          spaceBetween: 20,
        },
        1440: {
          slidesPerView: 5,
          spaceBetween: 20,
        },
      },
    });

    $(document).on('shopify:section:load', function () {
      // 重新初始化Swiper
      if (mySwiper) {
        mySwiper.destroy(true, true);
      }
      
      // 在初始化前隐藏轮播
      $('.section-id-{{ section.id }} .swiper').css('opacity', 0).removeClass('swiper-initialized');
      
      mySwiper = new Swiper('.section-id-{{ section.id }} .swiper', {
        loop: true,
        slidesPerView: 5,
        spaceBetween: 10,
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        on: {
          init: function () {
            // 初始化完成后显示轮播
            $('.section-id-{{ section.id }} .swiper').css('opacity', 1).addClass('swiper-initialized');
          }
        },
        breakpoints: {
          320: {
            slidesPerView: 1,
            spaceBetween: 10,
            centeredSlides: true,
          },
          480: {
            slidesPerView: 1.2,
            spaceBetween: 15,
            centeredSlides: true,
          },
          640: {
            slidesPerView: 1.5,
            spaceBetween: 15,
            centeredSlides: false,
          },
          768: {
            slidesPerView: 2,
            spaceBetween: 20,
          },
          1024: {
            slidesPerView: 3,
            spaceBetween: 20,
          },
          1280: {
            slidesPerView: 4,
            spaceBetween: 20,
          },
          1440: {
            slidesPerView: 5,
            spaceBetween: 20,
          },
        },
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Style List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Title"
    },
    {
      "type": "url",
      "id": "list_url",
      "label": "URL"
    },
    {
      "type": "text",
      "id": "url_text",
      "label": "URL Text",
      "default": "View All"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Btn Color",
      "default": "#D1D2C9"
    }
  ],
  "blocks": [
    {
      "type": "product-item",
      "name": "Product Item",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "idol_img",
          "label": "Idol Image"
        },
        {
          "type": "image_picker",
          "id": "model_img",
          "label": "模特图像"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product URL"
        },
        {
          "type": "text",
          "id": "model_name",
          "label": "姓名",
          "default": "xxx"
        },
        {
          "type": "text",
          "id": "model_height",
          "label": "身高",
          "default": "180cm"
        },
        {
          "type": "text",
          "id": "model_weight",
          "label": "体重",
          "default": "70kg"
        },
        {
          "type": "text",
          "id": "model_size",
          "label": "尺码",
          "default": "XL"
        },
        {
          "type": "text",
          "id": "model_comfort",
          "label": "试穿感受",
          "default": "合身"
        },
        {
          "type": "range",
          "id": "top_location",
          "min": 1,
          "max": 60,
          "step": 1,
          "unit": "%",
          "label": "pc端上间距",
          "default": 9
        },
        {
          "type": "range",
          "id": "left_location",
          "min": 1,
          "max": 80,
          "step": 1,
          "unit": "%",
          "label": "pc端左间距",
          "default": 11
        },
        {
          "type": "range",
          "id": "top_location2",
          "min": 1,
          "max": 60,
          "step": 1,
          "unit": "%",
          "label": "移动端上间距",
          "default": 9
        },
        {
          "type": "range",
          "id": "left_location2",
          "min": 1,
          "max": 80,
          "step": 1,
          "unit": "%",
          "label": "移动端左间距",
          "default": 11
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Style List",
      "category": "Product Style List",
      "settings": {},
      "blocks": [
        {
          "type": "product-item"
        },
        {
          "type": "product-item"
        },
        {
          "type": "product-item"
        },
        {
          "type": "product-item"
        },
        {
          "type": "product-item"
        }
      ]
    }
  ]
}
{% endschema %}