          "info": "电脑端右侧右下方图片,推荐尺寸：942x656"
        },
        {
          "type": "url",
          "id": "link_top_right2",
          "label": "link"
        },
        {
          "type": "image_picker",
          "id": "masterpiece_image_top_right3",
          "label": "image",
          "info": "电脑端右侧右上方图片,推荐尺寸：804x400"
        },
        {
          "type": "url",
          "id": "link_top_right3",
          "label": "link"
        },
        {
          "type": "image_picker",
          "id": "masterpiece_image_top_right4",
          "label": "image",
          "info": "电脑端右侧右下方图片,推荐尺寸：804x976"
        },
        {
          "type": "url",
          "id": "link_top_right4",
