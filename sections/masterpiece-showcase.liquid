        },
        {
          "type": "url",
          "id": "link2",
          "label": "link"
        },
        {
          "type": "image_picker",
          "id": "mobile_masterpiece_image",
          "label": "image",
          "info": "移动端左侧第一张图片,推荐尺寸：720x960"
        },
        {
          "type": "url",
          "id": "mobile_link",
          "label": "link"
        },
        {
          "type": "image_picker",
          "id": "mobile_masterpiece_image2",
          "label": "image",
          "info": "移动端左侧第二张图片,推荐尺寸：720x608"
        },
        {
          "type": "url",
          "id": "mobile_link2",
          "label": "link"
        },
        {
          "type": "image_picker",
          "id": "mobile_masterpiece_image3",
          "label": "image",
