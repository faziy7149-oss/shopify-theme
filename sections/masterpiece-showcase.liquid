        },
        {
          "type": "image_picker",
          "id": "mobile_masterpiece_image_top_right",
          "label": "image",
          "info": "移动端右侧第一张图,推荐尺寸：600x720"
        },
        {
          "type": "url",
          "id": "mobile_link_top_right",
          "label": "link"
        },
        {
          "type": "image_picker",
          "id": "mobile_masterpiece_image_top_right2",
          "label": "image",
          "info": "移动端右侧第二张图,推荐尺寸：600x480"
        },
        {
          "type": "url",
          "id": "mobile_link_top_right2",
          "label": "link"
        },
        {
          "type": "image_picker",
          "id": "mobile_masterpiece_image_top_right3",
          "label": "image",
          "info": "移动端右侧第三张图,推荐尺寸：600x348"
        },
        {
          "type": "url",
          "id": "mobile_link_top_right3",
          "label": "link"
        },
                {
          "type": "image_picker",
          "id": "mobile_masterpiece_image_bottom_right",
          "label": "image",
