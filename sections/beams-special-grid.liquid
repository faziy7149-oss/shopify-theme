{%- comment -%} BEAMS Special Grid & Modal {%- endcomment -%}

<section class="beams-special-section collection-slider-row for-collections" id="beams-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="beams-grid-container container{% if section.settings.full_width %} container--no-max{% endif %}" style="max-width: {{ section.settings.max_block_width }}px;">
    <div class="beams-masonry-wrapper">
      {%- for block in section.blocks -%}
        {%- assign product = all_products[block.settings.product] -%}
        {%- if product != blank -%}
          {%- comment -%} 添加 data-index 和特定的类 js-beams-loop {%- endcomment -%}
          <div class="beams-card-item js-beams-loop" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.release_text != blank -%}
              <div class="scrolling-label-wrap {{ block.settings.scroll_direction }}">
                <div class="scrolling-label">
                  <span>{{ block.settings.release_text }} &nbsp;&nbsp;</span>
                  <span>{{ block.settings.release_text }} &nbsp;&nbsp;</span>
                </div>
                <div class="scrolling-label">
                  <span>{{ block.settings.release_text }} &nbsp;&nbsp;</span>
                  <span>{{ block.settings.release_text }} &nbsp;&nbsp;</span>
                </div>
              </div>
            {%- endif -%}

            {%- if block.settings.sticker_img_1 != blank -%}
              <div class="sticker-element sticker-{{ block.id }} {{ block.settings.sticker_1_animation }}" style="top: {{ block.settings.sticker_1_y }}%; left: {{ block.settings.sticker_1_x }}%;">
              {%  render 'image' with block.settings.sticker_img_1, sizes: '1980px', loading: 'lazy', %}
              </div>
            {%- endif -%}

            <div class="beams-custom-images js-open-beams-modal" data-target="modal-{{ block.id }}">
              {%- assign has_custom_image = false -%}
              {%- if block.settings.custom_image_1 != blank -%}
                <img
                  src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                  data-src="{{ block.settings.custom_image_1 | image_url: width: 800 }}"
                  class="b-img active js-beams-lazy-image"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
                {%- assign has_custom_image = true -%}
              {%- endif -%}
              {%- if block.settings.custom_image_2 != blank -%}
                <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" data-src="{{ block.settings.custom_image_2 | image_url: width: 800 }}" class="b-img js-beams-lazy-image" loading="lazy" width="800" height="1000">
              {%- endif -%}
              {%- if block.settings.custom_image_3 != blank -%}
                <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" data-src="{{ block.settings.custom_image_3 | image_url: width: 800 }}" class="b-img js-beams-lazy-image" loading="lazy" width="800" height="1000">
              {%- endif -%}
              {%- if has_custom_image == false -%}
                <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" data-src="{{ product.featured_media | image_url: width: 800 }}" class="b-img active js-beams-lazy-image" loading="lazy" width="800" height="1000">
              {%- endif -%}
            </div>

            <div class="beams-product-info">
              <div class="product-block__title">{{ product.title | escape }}</div>
              <div class="product-price product-price--block">{% render 'price', product: product, show_labels: true %}</div>
            </div>

            <div class="custom-btn-overlay">
              <button type="button" class="beams-detail-btn js-open-beams-modal" data-target="modal-{{ block.id }}">
                {{ block.settings.btn_text | default: 'DETAIL +' }}
              </button>
            </div>
          </div>

          <div class="beams-modal-wrapper" id="modal-{{ block.id }}" aria-hidden="true" aria-modal="true" role="dialog" tabindex="-1" hidden>
            <div class="beams-modal-overlay js-close-beams-modal"></div>
            <div class="beams-modal-content">
              <button class="beams-modal-close js-close-beams-modal" aria-label="Close">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
              </button>

              <div class="beams-modal-layout">
                <div class="beams-modal-left">
                  <div class="modal-big-wrap">
                    <div class="modal-big-track js-modal-track">
                      {% for media in product.media %}
                        <img
                          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                          data-src="{{ media | image_url: width: 1000 }}"
                          class="modal-big-img {% if forloop.first %}active{% endif %} js-beams-lazy-image"
                          data-index="{{ forloop.index0 }}"
                          loading="lazy"
                          width="1000"
                          height="1000"
                        >
                      {% endfor %}
                    </div>
                    <!-- 箭头按钮 -->
                    <button class="nav-arrow prev" data-dir="-1">
                      {% render 'icon-chevron-left', stroke_width: 1.3 %}
                    </button>
                    <button class="nav-arrow next" data-dir="1">
                      {% render 'icon-chevron-right', stroke_width: 1.3 %}
                    </button>
                  </div>
                  <div class="modal-thumbs">
                    {% for media in product.media %}
                      <div class="thumb-item {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
                        <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" data-src="{{ media | image_url: width: 200 }}" class="js-beams-lazy-image" loading="lazy" width="200" height="200">
                      </div>
                    {% endfor %}
                  </div>
                </div>

                <div class="beams-modal-right">
                  <div class="modal-product-title">{{ product.title }}</div>
                  {%- if block.settings.release_text != blank -%}
                    <div class="modal-release-date">{{ block.settings.release_text }}</div>
                  {%- endif -%}
                  <div class="modal-product-desc">
                    {%- if block.settings.custom_description != blank -%}
                      {{ block.settings.custom_description }}
                    {%- else -%}
                      {{ product.description | strip_html | truncate: 180 }}
                    {%- endif -%}
                  </div>
                  <div class="modal-product-price product-price--block ">{% render 'price', product: product %}</div>
                  {% form 'product', product %}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" name="add" class="modal-buy-btn {% if block.settings.disable_checkout %}is-disabled{% endif %}" {% if block.settings.disable_checkout %}disabled{% endif %}>
                      {{ block.settings.btn_text2 | default: 'BUY NOW' }}
                    </button>
                  {% endform %}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  /* --- 保留原有的全部 CSS --- */
  .beams-special-section {
    overflow: hidden;
  }
  #beams-{{ section.id }} .beams-masonry-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6rem 8rem;
    align-items: start;
  }
  @media (max-width: 767px) {
    #beams-{{ section.id }} .beams-masonry-wrapper {
      grid-template-columns: 1fr;
    }
  }
  #beams-{{ section.id }} .beams-card-item {
    display: block;
    position: relative;
    overflow: visible;
  }
  #beams-{{ section.id }} .beams-custom-images {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #f4f4f4;
    overflow: hidden;
    cursor: pointer;
  }
  #beams-{{ section.id }} .beams-custom-images .b-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    will-change: opacity;
    z-index: 1;
  }
  #beams-{{ section.id }} .beams-custom-images .b-img.active {
    opacity: 1;
    z-index: 2;
  }
  #beams-{{ section.id }} .beams-product-info {
    margin-top: 15px;
    text-align: left;
  }
  #beams-{{ section.id }} .beams-product-info .product-block__title {
    margin-bottom: 10px;
  }
  #beams-{{ section.id }} .custom-btn-overlay {
    text-align: right;
    margin-top: -30px;
    position: relative;
    z-index: 5;
  }
  #beams-{{ section.id }} .beams-detail-btn {
    background: #000;
    color: #fff;
    border: none;
    padding: 8px 25px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 13px;
    transition: transform 0.2s;
  }
  #beams-{{ section.id }} .beams-detail-btn:hover {
    transform: scale(1.05);
  }
  #beams-{{ section.id }} .scrolling-label-wrap {
    position: absolute;
    top: 15px;
    right: -10px;
    width: 110px;
    height: 24px;
    background: {{ section.settings.scrolling_label_bg }};
    border: 1px solid {{ section.settings.scrolling_label_txt }};
    color: {{ section.settings.scrolling_label_txt }};
    z-index: 5;
    overflow: hidden;
    border-radius: 12px;
    display: flex;
    align-items: center;
    font-size: 11px;
    font-weight: bold;
  }
  #beams-{{ section.id }} .scrolling-label {
    display: inline-block;
    white-space: nowrap;
    /* padding-left: 100%; */
    animation: beams-scroll 8s linear infinite;
  }
  #beams-{{ section.id }} .right-to-left .scrolling-label {
    animation-direction: reverse;
  }
  @keyframes beams-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  #beams-{{ section.id }} .sticker-element {
    position: absolute;
    max-width: 100%;
    height: auto;
    z-index: 5;
    pointer-events: none;
  }
  {%- for block in section.blocks -%}
  #beams-{{ section.id }} .sticker-{{ block.id }} {
    width: {{ block.settings.sticker_width }}%;
  }
  {%- endfor -%}
  #beams-{{ section.id }} .animate-shake {
    animation: beams-shake 3s ease-in-out infinite;
  }
  #beams-{{ section.id }} .animate-flip {
    animation: beams-flip 4s linear infinite;
  }
  @keyframes beams-shake {
    0%,
    100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }
  @keyframes beams-flip {
    0% {
      transform: rotateY(0deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  #beams-{{ section.id }} .beams-modal-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  #beams-{{ section.id }} .beams-modal-wrapper.is-open {
    opacity: 1;
    visibility: visible;
  }
  #beams-{{ section.id }} .beams-modal-wrapper[hidden] {
    display: none !important;
  }
  #beams-{{ section.id }} .beams-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(5px);
    cursor: pointer;
  }
  #beams-{{ section.id }} .beams-modal-content {
    position: relative;
    width: 90%;
    max-width: 1000px;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    transform: translateY(20px);
    transition: transform 0.3s ease;
    max-height: 90vh;
    overflow-y: auto;
  }
  #beams-{{ section.id }} .beams-modal-wrapper.is-open .beams-modal-content {
    transform: translateY(0);
  }
  #beams-{{ section.id }} .beams-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #000;
    color: #fff;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.2s;
  }
  @media (min-width: 768px) {
    #beams-{{ section.id }} .beams-modal-layout {
      display: flex;
      height: 60vh;
    }
    #beams-{{ section.id }} .beams-modal-left {
      flex: 1 1 50%;
      width: 55%;
      background: #f9f9f9;
      padding: 20px;
      display: flex;
      flex-direction: column;
    }
  }

  #beams-{{ section.id }} .modal-big-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
  }
  #beams-{{ section.id }} .modal-big-img {
    position: relative; /* 取消 absolute */
    flex: 0 0 100%;    /* 每张图占满 100% 宽度 */
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 1;         /* 取消原本的透明度切换，改为物理位移 */
    scroll-snap-align: start; /* 核心：停止时自动对齐边缘 */
  }
  #beams-{{ section.id }} .modal-big-img.active {
    opacity: 1;
  }
  #beams-{{ section.id }} .modal-thumbs {
    display: flex;
    gap: 10px;
    margin-top: 15px;
    overflow: hidden;
  }
  #beams-{{ section.id }} .modal-thumbs::-webkit-scrollbar {
    display: none;
  }
  #beams-{{ section.id }} .thumb-item {
    width: 60px;
    height: 60px;
    cursor: pointer;
    border: 2px solid transparent;
    flex-shrink: 0;
  }
  #beams-{{ section.id }} .thumb-item.active {
    border-color: #000;
  }
  #beams-{{ section.id }} .thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #beams-{{ section.id }} .beams-modal-right {
    flex: 1 1 50%;
    padding: 50px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  #beams-{{ section.id }} .modal-product-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 15px;
  }
  #beams-{{ section.id }} .modal-release-date {
    color: {{ section.settings.scrolling_label_txt }};
    font-size: 14px;
    margin-bottom: 25px;
  }
  #beams-{{ section.id }} .modal-product-desc {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 30px;
  }
  #beams-{{ section.id }} .modal-product-price {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 30px;
  }
  #beams-{{ section.id }} .modal-buy-btn {
    background: #000;
    color: #fff;
    border: none;
    padding: 15px 0;
    width: 100%;
    border-radius: 30px;
    font-size: 16px;
    cursor: pointer;
  }
  #beams-{{ section.id }} .modal-big-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    /* display: flex; */
    overflow: hidden; /* 隐藏超出部分 */
    /* align-items: center; */
  }
  /* 新增轨道样式 */
  #beams-{{ section.id }} .modal-big-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
    scroll-snap-type: x mandatory; /* 核心：开启横向捕捉 */
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch; /* iOS 丝滑滚动 */
  }
  #beams-{{ section.id }} .modal-big-track::-webkit-scrollbar {
    display: none; /* 隐藏滚动条 */
  }
  #beams-{{ section.id }} .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.7);
    border: none;
    cursor: pointer;
    padding: 10px;
    z-index: 20;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #beams-{{ section.id }} .nav-arrow.prev {
    left: 10px;
  }
  #beams-{{ section.id }} .nav-arrow.next {
    right: 10px;
  }
  #beams-{{ section.id }} .modal-buy-btn.is-disabled {
    background-color: #d1d1d1 !important; /* 灰色背景 */
    color: #888 !important;            /* 灰色文字 */
    cursor: not-allowed;               /* 禁用状态的鼠标指针 */
    border: none;
    pointer-events: none;              /* 确保从 CSS 层面也拦截点击事件 */
  }
</style>

<script>
  function initBeamsGrid() {
    const section = document.querySelector('#beams-{{ section.id }}');
    if (!section) return;
    if (section.dataset.beamsInitialized === 'true') return;
    section.dataset.beamsInitialized = 'true';

    // 进入视口再设置真实图片地址，降低首屏加载压力
    const lazyImageObserver = new IntersectionObserver((entries, lazyObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const img = entry.target;
        const dataSrc = img.getAttribute('data-src');
        if (dataSrc && img.getAttribute('src') !== dataSrc) {
          img.setAttribute('src', dataSrc);
        }
        lazyObserver.unobserve(img);
      });
    }, { rootMargin: '300px 0px' });

    section.querySelectorAll('img.js-beams-lazy-image[data-src]').forEach((img) => {
      lazyImageObserver.observe(img);
    });

    let previousBodyOverflow = '';
    let activeModal = null;
    let lastTrigger = null;

    const focusableSelector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function loadModalImages(modal) {
      modal.querySelectorAll('img.js-beams-lazy-image[data-src]').forEach((img) => {
        const dataSrc = img.getAttribute('data-src');
        if (dataSrc && img.getAttribute('src') !== dataSrc) {
          lazyImageObserver.observe(img);
        }
      });
    }

    function trapFocus(event) {
      if (event.key !== 'Tab' || !activeModal) return;
      const focusableElements = Array.from(activeModal.querySelectorAll(focusableSelector))
        .filter((element) => !element.disabled && element.offsetParent !== null);
      if (!focusableElements.length) {
        event.preventDefault();
        activeModal.focus();
        return;
      }

      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      if (event.shiftKey && document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      } else if (!event.shiftKey && document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    }

    function handleKeydown(event) {
      if (!activeModal) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeModal(activeModal);
        return;
      }
      trapFocus(event);
    }

    function closeModal(modalToClose) {
      const modal = modalToClose || activeModal;
      if (!modal) return;

      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modal.hidden = true;
      document.body.style.overflow = previousBodyOverflow;
      document.removeEventListener('keydown', handleKeydown);

      if (lastTrigger && typeof lastTrigger.focus === 'function') {
        lastTrigger.focus();
      }

      activeModal = null;
      lastTrigger = null;
    }

    function openModal(modal, trigger) {
      if (!modal) return;
      if (activeModal && activeModal !== modal) {
        closeModal(activeModal);
      }

      previousBodyOverflow = document.body.style.overflow;
      lastTrigger = trigger || null;
      activeModal = modal;
      modal.hidden = false;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      loadModalImages(modal);
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', handleKeydown);

      const primaryFocusTarget = modal.querySelector('.beams-modal-close') || modal;
      window.requestAnimationFrame(() => {
        primaryFocusTarget.focus();
      });
    }

    // --- 修改点 1: 图片循环优化（针对 20+ Blocks 性能优化） ---
    const observerOptions = { threshold: 0.1 };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        // 只有进入视口的 Block 才会标记为可见
        entry.target.dataset.isVisible = entry.isIntersecting ? "true" : "false";
      });
    }, observerOptions);

    section.beamsCleanup = function() {
      if (activeModal) {
        closeModal(activeModal);
      } else {
        document.body.style.overflow = previousBodyOverflow;
        document.removeEventListener('keydown', handleKeydown);
      }

      section.querySelectorAll('.js-beams-loop').forEach(card => {
        if (card.rafId) cancelAnimationFrame(card.rafId);
      });
      section.querySelectorAll('.js-modal-track').forEach(track => {
        if (track.scrollTimer) clearTimeout(track.scrollTimer);
      });
      observer.disconnect();
      lazyImageObserver.disconnect();
      section.dataset.beamsInitialized = '';
      section.beamsCleanup = null;
    };

    section.querySelectorAll('.js-beams-loop').forEach((card) => {
      const wrapper = card.querySelector('.beams-custom-images');
      if (!wrapper) return;
      const imgs = wrapper.querySelectorAll('.b-img');
      if (imgs.length <= 1 || card.dataset.timerInit) return;
      
      card.dataset.timerInit = true;
      observer.observe(card); // 开始监听视口状态

      const blockIndex = parseInt(card.dataset.index) || 0;
      let lastTimestamp = null;
      let activeIdx = 0;
      const baseInterval = 3000; // 基础切换间隔
      // 修改点：利用索引取模，让相邻卡片永远有 600ms 的错峰延迟
      const staggerOffset = (blockIndex % 5) * 600; 
      let currentInterval = baseInterval + staggerOffset;

      function play(timestamp) {
        if (lastTimestamp === null) lastTimestamp = timestamp;

        // 核心逻辑：只有当前卡片在屏幕内，才计算时间
        if (card.dataset.isVisible === "true") {
          const elapsed = timestamp - lastTimestamp;

          if (elapsed > currentInterval) {
            imgs[activeIdx].classList.remove('active');
            activeIdx = (activeIdx + 1) % imgs.length;
            imgs[activeIdx].classList.add('active');
            lastTimestamp = timestamp;
            currentInterval = baseInterval;
          }
        } else {
          // 如果卡片在屏幕外，重置时间戳，防止回到屏幕时出现“追赶”闪烁
          lastTimestamp = timestamp;
        }

        card.rafId = requestAnimationFrame(play);
      }
      
      card.rafId = requestAnimationFrame(play);
    });

    // --- 修改点 2: 弹窗逻辑（原有逻辑，添加 body 滚动控制） ---
    section.querySelectorAll('.js-open-beams-modal').forEach(b => {
      b.onclick = (e) => {
        e.preventDefault();
        const target = document.getElementById(b.dataset.target);
        if (target) {
          openModal(target, b);
        }
      }
    });

    section.querySelectorAll('.js-close-beams-modal').forEach(b => {
      b.onclick = () => {
        closeModal(b.closest('.beams-modal-wrapper'));
      }
    });

      // --- 修改点：缩略图点击逻辑 ---
      section.querySelectorAll('.thumb-item').forEach(t => {
        t.onclick = function () {
          const p = this.closest('.beams-modal-content');
          const track = p.querySelector('.js-modal-track');
          const index = parseInt(this.dataset.index);
          
          // 同步缩略图状态
          p.querySelectorAll('.thumb-item').forEach(x => x.classList.remove('active'));
          this.classList.add('active');

          // 核心修改：滚动轨道
          track.scrollTo({
            left: track.offsetWidth * index,
            behavior: 'smooth'
          });
        };
      });

      // --- 修改点：箭头点击逻辑 ---
      section.querySelectorAll('.nav-arrow').forEach(btn => {
        btn.onclick = function(e) {
          e.stopPropagation();
          const p = this.closest('.beams-modal-content');
          const track = p.querySelector('.js-modal-track');
          const bigImgs = p.querySelectorAll('.modal-big-img');
          
          // 计算当前是第几张（基于滚动偏移量）
          let currentIndex = Math.round(track.scrollLeft / track.offsetWidth);
          let nextIndex = (currentIndex + parseInt(this.dataset.dir) + bigImgs.length) % bigImgs.length;

          // 执行滚动
          track.scrollTo({
            left: track.offsetWidth * nextIndex,
            behavior: 'smooth'
          });
          
          // 缩略图同步逻辑会由下方的 scroll 监听器统一处理
        };
      });

      // --- 新增：监听滚动停止，同步缩略图状态 ---
      section.querySelectorAll('.js-modal-track').forEach(track => {
        track.addEventListener('scroll', function() {
          // 简单的防抖处理，确保滑动停止后才更新 UI
          clearTimeout(this.scrollTimer);
          this.scrollTimer = setTimeout(() => {
            const p = this.closest('.beams-modal-content');
            const index = Math.round(this.scrollLeft / this.offsetWidth);
            const thumbs = p.querySelectorAll('.thumb-item');
            
            // 更新缩略图高亮
            thumbs.forEach(x => x.classList.remove('active'));
            if(thumbs[index]) {
              thumbs[index].classList.add('active');
              thumbs[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          }, 100);
        });
      });
  }

  // --- 修改点 4: 内存清理（防止 Shopify 编辑器预览时内存泄露） ---
  document.addEventListener('shopify:section:unload', (event) => {
    if (event.detail.sectionId === '{{ section.id }}') {
      const section = document.querySelector('#beams-{{ section.id }}');
      if (section && typeof section.beamsCleanup === 'function') {
        section.beamsCleanup();
      }
    }
  });

  document.addEventListener('DOMContentLoaded', initBeamsGrid);
  document.addEventListener('shopify:section:load', initBeamsGrid);
</script>

